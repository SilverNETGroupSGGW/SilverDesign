{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": [],

    /* Strict, and then some. The library is the contract a design agent codes
       against, so a type that lies here produces wrong code everywhere.

       `exactOptionalPropertyTypes` is deliberately off: forwarding an optional
       prop (`<Card href={maybeUndefined}>`) is the normal React idiom, every
       component here treats a missing prop and an undefined one identically,
       and the flag would only force `{...(href ? { href } : {})}` noise into
       the components a design agent reads as examples. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}
