{
  "projectId": "ec7e00a3-9714-4b87-948d-b5dcdc03da04",
  "pkg": "@silver/ui",
  "globalName": "SilverUI",
  "shape": "package",
  "buildCmd": "bun run build",
  "srcDir": "src",
  "tsconfig": "tsconfig.json",
  "cssEntry": "dist/ds.css",
  "extraFonts": ["dist/fonts/fonts.css"],
  "provider": {
    "component": "SilverProvider",
    "props": {
      "surface": "void",
      "style": {
        "minHeight": "100%",
        "padding": "28px"
      },
      "drift": true
    }
  },
  "overrides": {
    "Foil": {
      "cardMode": "column"
    },
    "Heading": {
      "cardMode": "column"
    }
  },
  "readmeHeader": ".design-sync/conventions.md"
}
