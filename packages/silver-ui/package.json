{
  "name": "@silver/ui",
  "version": "0.1.0",
  "description": "Silver design system — React components for the SGGW software engineering club.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack && bun scripts/bundle-css.mjs",
    "check": "vp check",
    "fix": "vp check --fix"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.9"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
