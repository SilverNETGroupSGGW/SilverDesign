---
import { getEntry } from "astro:content";
import Footer from "../components/Footer.astro";
import MarkDefs from "../components/MarkDefs.astro";
import Opener from "../components/Opener.astro";
import { BASE, withBase } from "../lib/base";
import { locales, pathFor, type Locale, type RouteKey } from "../lib/i18n";
import "../styles/tokens.css";
import "../styles/base.css";

interface Props {
  locale: Locale;
  route: RouteKey;
  title: string;
  description: string;
  variant: "home" | "page";
  heading: string;
  lead: string;
}
const { locale, route, title, description, variant, heading, lead } = Astro.props;
const copy = (await getEntry("copy", locale))!.data;
const site = (await getEntry("site", "site"))!.data;
const canonical = new URL(pathFor(route, locale), Astro.site);
const ogLocales = { pl: "pl_PL", en: "en_GB" } as const;
const homePaths = [withBase(""), ...locales.map((l) => pathFor("home", l))];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <slot name="head" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(route, l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor(route, "pl"), Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[locale]} />
    <meta property="og:locale:alternate" content={ogLocales[locale === "pl" ? "en" : "pl"]} />
    <meta property="og:image" content={new URL(withBase("og.png"), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(withBase("og.png"), Astro.site)} />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <link rel="preload" href={withBase("fonts/Geist-Variable.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase("fonts/GeistMono-Variable.woff2")} as="font" type="font/woff2" crossorigin />
    {/* No high priority: the LCP element is the lead on the home page and the first card's
        screenshot on the listings, never the foil, and a high hint puts the texture ahead of both. */}
    <link rel="preload" href={withBase("brand/foil-texture.jpg")} as="image" />
    <meta name="theme-color" content="#16161B" />
    {/* Entrances hide their elements from the first frame, so something already painted never
        blinks out and back in; reveal.ts takes over, and if it never arrives the page opens up by
        itself. */}
    <script is:inline define:vars={{ variant, homePaths }}>
      try {
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          const root = document.documentElement;
          root.dataset.reveals = "";
          setTimeout(() => {
            if (root.dataset.reveals === "") delete root.dataset.reveals;
          }, 3000);
        }
      } catch {}
      // The lockup flies between the hero and the navigation's corner (Opener.astro): both pages
      // put it on its own layer for the frames the transition captures, the old one as it leaves
      // and the new one before its first frame. Between two pages of one kind it stays with the
      // page's crossfade: on its own layer it would slide by however far the old page was scrolled,
      // since the new one opens at the top.
      addEventListener("pageswap", (e) => {
        if (!e.viewTransition) return;
        const to = e.activation?.entry?.url;
        const url = to === undefined ? undefined : new URL(to);
        // No flight from or to a lockup off screen (scrolled past here, or a section further down
        // the home page such as the navigation's #join), nor while the home page is still drawing
        // its arrival, where the lockup is not all there yet: those go with the crossfade.
        const here = document.querySelector(".lockup-vt")?.getBoundingClientRect();
        const crossing =
          url !== undefined &&
          url.hash === "" &&
          homePaths.includes(url.pathname) !== (variant === "home") &&
          here !== undefined &&
          here.bottom > 0 &&
          !document.querySelector(".home .ribbon")?.getAnimations().some((a) => a.playState === "running");
        if (crossing) document.documentElement.classList.add("vt-lockup");
        try {
          sessionStorage.setItem("silver-from", crossing ? variant : "");
          sessionStorage.setItem("silver-fly", JSON.stringify(crossing ? flyerBoxes() : null));
        } catch {}
      });
      // What flies, by transition name (Opener.astro). The browser's own group animation also
      // animates width and height, which runs on the main thread while opacity and transform run on
      // the compositor, so under any jank the pieces drift apart. Each group instead gets one
      // transform from its box on the last page to its exact box here: compositor only, all in
      // step, and landing on the element's own fractional position with nothing to snap.
      const flyers = {
        "silver-lockup": ".lockup-vt",
        "nav-projects": '.opener nav a[data-nav="projects"]',
        "nav-history": '.opener nav a[data-nav="history"]',
        "nav-join": '.opener nav a[data-nav="join"]',
        "nav-locale": ".opener nav .switch",
      };
      const flyerBoxes = () => {
        const boxes = {};
        for (const [name, selector] of Object.entries(flyers)) {
          const r = document.querySelector(selector)?.getBoundingClientRect();
          if (r) boxes[name] = [r.left, r.top, r.width, r.height];
        }
        return boxes;
      };
      // Each growing arm's length to where it leaves the opener, in the mark's units: `pre` units of
      // path, then straight on from a point along a direction (data-ray, Opener.astro).
      const measureArms = () => {
        for (const path of document.querySelectorAll(".grow [data-ray]")) {
          const m = path.ownerSVGElement.getScreenCTM();
          const box = path.closest(".opener").getBoundingClientRect();
          const [pre, x, y, vx, vy] = path.dataset.ray.split(" ").map(Number);
          const across = ((vx < 0 ? box.left : box.right) - m.e) / m.a;
          const t = Math.min(
            vx ? (across - x) / vx : Infinity,
            vy < 0 ? ((box.top - m.f) / m.d - y) / vy : Infinity,
          );
          const width = Number(path.parentNode.getAttribute("stroke-width"));
          path.style.setProperty("--len", String(pre + Math.max(t, 0) + width));
        }
      };
      addEventListener("pagereveal", (e) => {
        let fly = null;
        try {
          fly = JSON.parse(sessionStorage.getItem("silver-fly") ?? "null");
          sessionStorage.removeItem("silver-fly");
        } catch {}
        if (!e.viewTransition) return;
        const root = document.documentElement;
        let from = variant;
        try {
          from = sessionStorage.getItem("silver-from") || variant;
        } catch {}
        // Between two pages the lockup stays in the corner and the arms stay drawn.
        if (from === variant) return;
        root.classList.add("vt-lockup");
        e.viewTransition.finished.finally(() => root.classList.remove("vt-lockup", "vt-grow", "vt-shrink"));
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        if (fly) {
          const here = flyerBoxes();
          const style = document.createElement("style");
          style.textContent = Object.entries(fly)
            .filter(([name]) => here[name])
            .map(([name, [x0, y0, w0, h0]]) => {
              const [x1, y1, w1, h1] = here[name];
              return `::view-transition-group(${name}){animation-name:fly-${name};transform-origin:0 0}@keyframes fly-${name}{from{transform:matrix(${w0 / w1},0,0,${h0 / h1},${x0},${y0})}to{transform:matrix(1,0,0,1,${x1},${y1})}}`;
            })
            .join("");
          document.head.append(style);
          e.viewTransition.finished.finally(() => style.remove());
          // Which way the lockup's size goes decides which of its two pictures carries the flight.
          root.classList.add(variant === "home" ? "vt-grow" : "vt-shrink");
        }
        root.classList.add("vt-move");
        if (variant === "home") root.dataset.hero = "still";
        e.viewTransition.ready.then(() => {
          measureArms();
          root.classList.add("vt-landed");
        });
      });
      addEventListener("animationend", (e) => {
        if (e.animationName === "arms-grow")
          document.documentElement.classList.remove("vt-move", "vt-landed");
      });
      // Only a page restored from the back-forward cache still carries its own pageswap's classes. On
      // a fresh load pageshow can fire mid-flight, and the drawing's lockup would show under the one
      // still flying in.
      addEventListener("pageshow", (e) => {
        if (e.persisted) document.documentElement.classList.remove("vt-lockup", "vt-move", "vt-landed");
      });
    </script>
    {/* Back from another page of the site, the home page is already at rest; a reload and the
        root's redirect to /en/ replay the arrival. Inline in the head so the attribute is set
        before the first frame. */}
    {variant === "home" && (
      <script is:inline define:vars={{ rootPath: BASE }}>
        try {
          const [entry] = performance.getEntriesByType("navigation");
          const from = new URL(document.referrer);
          if (entry.type !== "reload" && from.origin === location.origin && from.pathname !== rootPath)
            document.documentElement.dataset.hero = "still";
        } catch {}
      </script>
    )}
  </head>
  <body>
    <a class="visually-hidden skip-link" href="#main">{copy.nav.skip}</a>
    <MarkDefs />
    <Opener locale={locale} route={route} variant={variant} title={heading} lead={lead}>
      <slot name="cta" />
    </Opener>
    <main class:list={[variant === "home" ? "after-opener" : "after-header"]}>
      <slot />
    </main>
    <Footer locale={locale} route={route} />
    <script>
      import { watchReveals } from "../lib/reveal";
      watchReveals();
    </script>
  </body>
</html>

{/* Here and not in base.css, which the brochures share: their renderer walks the four sheets in one
    tab and must never screenshot a crossfade. */}
<style is:global>
  /* Between two subpages the dimmed band and the navigation are the same pixels, so a crossfade
     leaves them standing and changes only what differs. */
  @view-transition {
    navigation: auto;
  }
  /* What is on screen at load enters after the page's own heading: on a phone the home page's first
     section shares the first screen with the hero and waits for its sequence. Anything revealed
     later by scrolling starts at once (reveal.ts). */
  main {
    --reveal-start: 250ms;
  }
  :root:not([data-hero="still"]) main.after-opener {
    --reveal-start: 1150ms;
  }
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 200ms;
  }
  ::view-transition-group(silver-lockup),
  ::view-transition-group(.nav) {
    animation-duration: 650ms;
    animation-timing-function: cubic-bezier(0.5, 0, 0.15, 1);
  }
  ::view-transition-old(silver-lockup),
  ::view-transition-new(silver-lockup),
  ::view-transition-old(.nav),
  ::view-transition-new(.nav) {
    animation-duration: 650ms;
  }
  /* The lockup's two pictures are the same marks at sizes up to a dozen times apart, and the small
     one blown up is a smear. The large one carries the flight: leaving the hero, the old picture
     holds until the last fifth, by when the lockup is nearly corner-sized; landing in it, the new
     picture takes over in the first fifth. */
  ::view-transition-old(silver-lockup),
  ::view-transition-new(silver-lockup) {
    mix-blend-mode: plus-lighter;
    animation-timing-function: linear;
  }
  :root.vt-shrink::view-transition-old(silver-lockup) {
    animation-name: lockup-hold;
  }
  :root.vt-shrink::view-transition-new(silver-lockup) {
    animation-name: lockup-late;
  }
  :root.vt-grow::view-transition-old(silver-lockup) {
    animation-name: lockup-leave;
  }
  :root.vt-grow::view-transition-new(silver-lockup) {
    animation-name: lockup-take;
  }
  @keyframes lockup-hold {
    80% {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
  @keyframes lockup-late {
    from,
    80% {
      opacity: 0;
    }
  }
  @keyframes lockup-leave {
    20%,
    to {
      opacity: 0;
    }
  }
  @keyframes lockup-take {
    from {
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(silver-lockup),
    ::view-transition-old(silver-lockup),
    ::view-transition-new(silver-lockup),
    ::view-transition-group(.nav),
    ::view-transition-old(.nav),
    ::view-transition-new(.nav) {
      animation-duration: 0s;
    }
  }
</style>
