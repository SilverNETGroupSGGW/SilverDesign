---
import { getEntry } from "astro:content";
import Footer from "../components/Footer.astro";
import MarkDefs from "../components/MarkDefs.astro";
import Opener from "../components/Opener.astro";
import { locales, pathFor, type Locale, type RouteKey } from "../lib/i18n";
import "../styles/tokens.css";
import "../styles/base.css";

interface Props {
  locale: Locale;
  route: RouteKey;
  title: string;
  description: string;
  /** The opener: the page's own heading and lead, wrapped around the ribbon. */
  variant: "home" | "page";
  heading: string;
  lead: string;
}
const { locale, route, title, description, variant, heading, lead } = Astro.props;
const copy = (await getEntry("copy", locale))!.data;
const site = (await getEntry("site", "site"))!.data;
const canonical = new URL(pathFor(route, locale), Astro.site);
const ogLocales = { pl: "pl_PL", en: "en_GB" } as const;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(route, l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor(route, "pl"), Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[locale]} />
    <meta property="og:locale:alternate" content={ogLocales[locale === "pl" ? "en" : "pl"]} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og.png", Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />
    {/* Warmed early but not ahead of the queue: the LCP element is the lead on the home page and
        the first card's screenshot on the listings, never the 108 KB foil, and a high hint put the
        texture in front of both (mobile LCP 2.9 s → 2.0 s on /pl/, 3.1 s → 2.6 s on /pl/projekty/). */}
    <link rel="preload" href="/brand/foil-texture.jpg" as="image" />
    <meta name="theme-color" content="#16161B" />
    {/* Coming back to the home page from another page of the site, it is already at rest: the
        arrival sequence is for the first look; a reload and the root redirect play it again. Inline
        and in the head so the attribute is there before the first frame. */}
    {/* Entrances hide their elements from the first frame, so something already painted never
        blinks out and back in; reveal.ts takes over, and if it never arrives the page opens up by
        itself. Under reduced motion nothing is hidden. */}
    <script is:inline>
      try {
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          const root = document.documentElement;
          root.dataset.reveals = "";
          setTimeout(() => {
            if (root.dataset.reveals === "") delete root.dataset.reveals;
          }, 3000);
        }
      } catch {}
      // The lockup flies between the hero and the navigation's corner (Opener.astro): both pages
      // put it on its own layer for the frames the transition captures, the old one as it leaves
      // and the new one before its first frame.
      addEventListener("pageswap", (e) => {
        if (e.viewTransition) document.documentElement.classList.add("vt-lockup");
      });
      addEventListener("pagereveal", (e) => {
        if (!e.viewTransition) return;
        const root = document.documentElement;
        root.classList.add("vt-lockup");
        e.viewTransition.finished.finally(() => root.classList.remove("vt-lockup"));
      });
      addEventListener("pageshow", () => document.documentElement.classList.remove("vt-lockup"));
    </script>
    {variant === "home" && (
      <script is:inline>
        try {
          const [entry] = performance.getEntriesByType("navigation");
          const from = new URL(document.referrer);
          if (entry.type !== "reload" && from.origin === location.origin && from.pathname !== "/")
            document.documentElement.dataset.hero = "still";
        } catch {}
      </script>
    )}
  </head>
  <body>
    <a class="visually-hidden skip-link" href="#main">{copy.nav.skip}</a>
    <MarkDefs />
    <Opener locale={locale} route={route} variant={variant} title={heading} lead={lead}>
      <slot name="cta" />
    </Opener>
    <main class:list={[variant === "home" ? "after-opener" : "after-header"]}>
      <slot />
    </main>
    <Footer locale={locale} route={route} />
    <script>
      import { watchReveals } from "../lib/reveal";
      watchReveals();
    </script>
  </body>
</html>

{/* Here and not in base.css, which the brochures share: their renderer walks the four sheets in one
    tab and must never screenshot a crossfade. */}
<style is:global>
  /* Between two subpages the dimmed band and the navigation are the same pixels, so a crossfade
     leaves them standing and changes only what differs. */
  @view-transition {
    navigation: auto;
  }
  /* What is on screen at load enters after the page's own heading: on a phone the home page's first
     section shares the first screen with the hero and waits for its sequence, and a page's first
     rows follow its title. Anything revealed later by scrolling starts at once (reveal.ts). */
  main {
    --reveal-start: 250ms;
  }
  :root:not([data-hero="still"]) main.after-opener {
    --reveal-start: 1150ms;
  }
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 200ms;
  }
  ::view-transition-group(silver-lockup) {
    animation-duration: 650ms;
    animation-timing-function: cubic-bezier(0.5, 0, 0.15, 1);
  }
  ::view-transition-old(silver-lockup),
  ::view-transition-new(silver-lockup) {
    animation-duration: 650ms;
  }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(silver-lockup),
    ::view-transition-old(silver-lockup),
    ::view-transition-new(silver-lockup) {
      animation-duration: 0s;
    }
  }
</style>
