---
import MarkDefs from "../components/MarkDefs.astro";
import type { Locale } from "../lib/i18n";
import { markRibbon } from "../lib/mark";
import "../styles/tokens.css";
import "../styles/base.css";

interface Props {
  locale: Locale;
  title: string;
  /** Where the mark's box starts, which is what puts the ribbon on the sheet. */
  markTop: string;
}
const { locale, title, markTop } = Astro.props;
// The ribbon's place on the sheet is a function of where the mark sits, so the sheet carries the
// mark's own fractions and works the rest out in calc().
const ribbonVars = [
  `--rb-ax:${markRibbon.lowerAxis[0]!.toFixed(6)}`,
  `--rb-ay:${markRibbon.lowerAxis[1]!.toFixed(6)}`,
  `--rb-half:${markRibbon.halfRise.toFixed(6)}`,
  `--mark-top:${markTop}`,
].join(";");
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1240" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body>
    <MarkDefs />
    <div class="page" style={ribbonVars}>
      <slot />
    </div>
  </body>
</html>

<style is:global>
  html {
    font-size: 22px;
  }
  body {
    min-height: 0;
    background: var(--bg);
  }
  /* A sheet has no viewport to scale against, so print carries its own fixed scale next to the
     fluid one the screen uses. */
  .page {
    --print-space-1: 8px;
    --print-space-2: 16px;
    --print-space-3: 24px;
    --print-space-4: 40px;
    --print-step--1: 18px;
    --print-step-0: 21px;
    --print-step-1: 24px;
    --print-step-2: 27px;
    --print-step-3: 30px;
    --print-step-4: 36px;
    --print-step-5: 82px;
    --cut: 40px;
    --marker: 40px;
    --marker-weight: 4px;

    --sheet-w: 1240px;
    --sheet-h: 1754px;
    --pad: 96px;
    /* 32px measured square to the ribbon, which a block set by its vertical distance overshoots. */
    --clear: calc(32px / cos(var(--angle)));
    --gap: 20px;
    --mark-size: 280px;

    /* A point on the centreline of the arm that leaves the mark towards the bottom left, and the
       vertical distance from any centreline to the ribbon's own edge. */
    --rb-x: calc(var(--sheet-w) - var(--pad) - (1 - var(--rb-ax)) * var(--mark-size));
    --rb-y: calc(var(--mark-top) + var(--rb-ay) * var(--mark-size));
    --rb-edge: calc(var(--rb-half) * var(--mark-size));

    position: relative;
    isolation: isolate;
    width: var(--sheet-w);
    height: var(--sheet-h);
    overflow: hidden;
    font-size: var(--print-step-0);
  }
  .page .markwrap {
    position: absolute;
    display: flex;
    inset-block-start: var(--mark-top);
    inset-inline-end: var(--pad);
    inline-size: var(--mark-size);
  }
  .page .block {
    position: absolute;
    top: var(--top, auto);
    left: var(--left);
    width: var(--w);
  }
  /* Above the ribbon: --anchor is the x of the bottom-right corner, the one the diagonal reaches
     first. */
  .page .over {
    bottom: calc(
      var(--sheet-h) - var(--rb-y) + var(--rb-edge) + var(--clear) -
        (var(--rb-x) - var(--anchor, calc(var(--left) + var(--w)))) * tan(var(--angle))
    );
  }
  /* Below it the top-left corner is the near one. */
  .page .under {
    top: calc(
      var(--rb-y) + var(--rb-edge) + var(--clear) + (var(--rb-x) - var(--anchor, var(--left))) *
        tan(var(--angle))
    );
  }
  .page .row {
    display: grid;
    gap: var(--print-space-2);
    align-content: start;
  }
  .page .cards {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .page h1 {
    display: grid;
    gap: var(--print-space-1);
    max-width: none;
  }
  .page .wordmark {
    font-size: var(--print-step-5);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .page .tagline {
    font-size: var(--print-step-4);
    font-weight: 500;
  }
  .page h2 {
    font-size: var(--print-step-3);
  }
  .page .angled::before {
    margin-block-end: var(--print-space-2);
  }
  .page p {
    max-width: none;
  }
  .page .mono {
    font-size: var(--print-step--1);
  }
  .page .muted {
    color: var(--muted);
  }
  .page .lead {
    font-size: var(--print-step-2);
    margin-top: var(--print-space-3);
    max-width: none;
  }
  .page .card {
    display: grid;
    gap: var(--print-space-1);
    align-content: start;
    padding: var(--print-space-3);
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: var(--print-step--1);
  }
  .page .card strong {
    font-size: var(--print-step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .page .masthead {
    top: 60px;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--print-space-4);
    align-items: start;
  }
  .page .masthead .lead {
    margin-top: 0;
  }
  /* The sheet's own ground under a rule, so the block reads as a plate without a second value. */
  .page .plate {
    bottom: var(--pad);
    background: var(--bg);
    border: 1px solid var(--line);
    padding: var(--print-space-4);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--print-space-4);
    align-items: center;
  }
  .page .ask {
    display: grid;
    gap: var(--print-space-3);
    align-content: center;
  }
  .page .lines {
    display: grid;
    gap: var(--print-space-1);
  }
  /* The code reads against the sheet's own ground, so the padding around it is the quiet zone;
     the caption keeps the same distance below. */
  /* The caption keeps the code's own quiet zone below it, as the plate's padding does elsewhere. */
  .page .code p {
    margin-top: var(--print-space-4);
    font-size: var(--print-step--1);
    max-width: 20ch;
  }
</style>
