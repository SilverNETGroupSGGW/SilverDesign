---
import MarkDefs from "../components/MarkDefs.astro";
import type { Locale } from "../lib/i18n";
import "../styles/tokens.css";
import "../styles/base.css";

interface Props {
  locale: Locale;
  title: string;
}
const { locale, title } = Astro.props;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1240" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body>
    <MarkDefs />
    <div class="page">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  html {
    font-size: 22px;
  }
  body {
    min-height: 0;
    background: var(--bg);
  }
  /* A sheet has no viewport to scale against, so print carries its own fixed scale next to the
     fluid one the screen uses. */
  .page {
    --print-space-1: 8px;
    --print-space-2: 16px;
    --print-space-3: 24px;
    --print-space-4: 40px;
    --print-step--1: 18px;
    --print-step-0: 21px;
    --print-step-1: 24px;
    --print-step-2: 27px;
    --print-step-3: 30px;
    --print-step-4: 36px;
    --cut: 40px;
    --marker: 40px;
    --marker-weight: 4px;

    --sheet-w: 1240px;
    --sheet-h: 1754px;
    --pad: 96px;
    --gap: 20px;

    position: relative;
    isolation: isolate;
    width: var(--sheet-w);
    height: var(--sheet-h);
    overflow: hidden;
    font-size: var(--print-step-0);
    display: flex;
    flex-direction: column;
    gap: var(--print-space-3);
    padding-block-end: var(--pad);
  }
  /* A sheet is a fixed box: a block that does not fit has to report as overflow, not be squeezed
     into the space that is left. */
  .page > * {
    flex: 0 0 auto;
  }
  /* Astro leaves the opener's module script in place, and a flex container would give it a row of
     its own. */
  .page > script {
    display: none;
  }
  /* The opener is the only block that reaches the sheet's edges: the ribbon has to leave through
     them. */
  .page > :not(.opener) {
    margin-inline: var(--pad);
  }
  .page > .plate {
    margin-block-start: auto;
  }
  .page .row {
    display: grid;
    gap: var(--print-space-2);
    align-content: start;
  }
  .page .cards {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .page h2 {
    font-size: var(--print-step-3);
  }
  .page .angled::before {
    margin-block-end: var(--print-space-2);
  }
  .page p {
    max-width: none;
  }
  .page .mono {
    font-size: var(--print-step--1);
  }
  .page .muted {
    color: var(--muted);
  }
  .page .card {
    display: grid;
    gap: var(--print-space-1);
    align-content: start;
    padding: var(--print-space-3);
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: var(--print-step--1);
  }
  .page .card strong {
    font-size: var(--print-step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  /* The sheet's own ground under a rule, so the block reads as a plate without a second value. */
  .page .plate {
    background: var(--bg);
    border: 1px solid var(--line);
    padding: var(--print-space-4);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--print-space-4);
    align-items: center;
  }
  .page .ask {
    display: grid;
    gap: var(--print-space-3);
    align-content: center;
  }
  .page .lines {
    display: grid;
    gap: var(--print-space-1);
  }
  /* The plate's padding is the code's quiet zone on three sides; the caption keeps the same
     distance below it. */
  .page .code p {
    margin-top: var(--print-space-4);
    font-size: var(--print-step--1);
    max-width: 20ch;
  }
</style>
