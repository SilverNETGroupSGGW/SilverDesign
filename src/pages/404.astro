---
import { getEntry } from "astro:content";
import Footer from "../components/Footer.astro";
import Mark from "../components/Mark.astro";
import MarkDefs from "../components/MarkDefs.astro";
import { withBase } from "../lib/base";
import { locales, pathFor } from "../lib/i18n";
import "../styles/tokens.css";
import "../styles/base.css";

const site = (await getEntry("site", "site"))!.data;
const sides = await Promise.all(
  locales.map(async (locale) => {
    const copy = (await getEntry("copy", locale))!.data;
    return {
      locale,
      copy: copy.notFound,
      navLabel: copy.nav.mainLabel,
      home: pathFor("home", locale),
      links: [
        { href: pathFor("projects", locale), label: copy.nav.projects },
        { href: pathFor("history", locale), label: copy.nav.history },
        { href: `${pathFor("home", locale)}#join`, label: copy.nav.join },
      ],
    };
  }),
);
const title = sides.map((s) => s.copy.title).join(" · ");
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>{`${title} — ${site.name}`}</title>
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <link rel="preload" href={withBase("fonts/Geist-Variable.woff2")} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#16161B" />
  </head>
  <body>
    <MarkDefs />
    <main id="main" class="container page">
      <a class="brand" href={sides[0]!.home} aria-label={site.name}>
        <Mark size="4rem" />
      </a>
      {sides.map((s, i) => (
        <section lang={s.locale}>
          {i === 0 ? <h1>{s.copy.title}</h1> : <h2>{s.copy.title}</h2>}
          <p>{s.copy.body}</p>
          <p><a href={s.home}>{s.copy.home}</a></p>
          <nav class="ways" aria-label={s.navLabel}>
            {s.links.map((l) => <a href={l.href}>{l.label}</a>)}
          </nav>
        </section>
      ))}
    </main>
    {/* A 404 has no locale of its own and the footer says the same in both: Polish, the site's
        default, with the switch pointing at the English home page. */}
    <Footer locale="pl" route="home" />
  </body>
</html>

<style>
  /* The two sides stay centred in what is left of the first screen once the footer has its room,
     so nothing has to be scrolled to for the way onward. */
  .page {
    min-height: max(60vh, 100vh - 30rem);
    padding-block: var(--space-6);
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-5);
  }
  .brand {
    display: inline-block;
  }
  section {
    display: grid;
    gap: var(--space-2);
  }
  h1 {
    font-size: var(--step-3);
  }
  h2 {
    font-size: var(--step-1);
  }
  section p {
    color: var(--muted);
  }
  section a {
    padding-block: 0.45rem;
  }
  .ways {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  .ways a {
    color: var(--muted);
    text-decoration: none;
  }
  .ways a:hover {
    color: var(--ink);
  }
</style>
