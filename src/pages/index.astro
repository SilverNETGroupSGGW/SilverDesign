---
import { withBase } from "../lib/base";
import { pathFor } from "../lib/i18n";

const target = pathFor("home", "pl");
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    {/* Without one, the browser asks the domain's root for /favicon.ico, which a project site does
        not own. */}
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <title>Silver</title>
    {/* A slow connection still paints this frame before the redirect, and the site is dark
        throughout. Nothing here loads tokens.css, so --bg and --ink are repeated as literals. */}
    <style is:inline>
      :root {
        color-scheme: dark;
        background: #16161b;
        color: #d8dbde;
        font-family: system-ui, sans-serif;
      }
      body {
        margin: 2rem;
      }
      a {
        color: #d8dbde;
      }
    </style>
  </head>
  <body>
    <a href={target}>Silver — strona koła</a>
  </body>
</html>
