---
import { getEntry } from "astro:content";
import { pathFor, type Locale, type RouteKey } from "../lib/i18n";
import { lockupPath } from "../lib/lockup";
import { markPathId, markPattern, markRibbonPath, markViewBox } from "../lib/mark";
import {
  backdropVariants,
  formCss,
  lockupBox,
  markOrigin,
  openerLayouts,
  openerStyle,
  polygonCss,
  shapeAbove,
  shapeBelow,
  TITLE_LINE_HEIGHT,
  titleLines,
} from "../lib/opener";
import LocaleSwitch from "./LocaleSwitch.astro";

interface Props {
  locale: Locale;
  variant: "home" | "page" | "sheet";
  title: string;
  lead: string;
  /** Given for a page of the site, which carries the navigation and links the mark home. */
  route?: RouteKey;
}
const { locale, variant, title, lead, route } = Astro.props;
const backdrop = backdropVariants.has(variant);
const copy = (await getEntry("copy", locale))!.data;
const site = (await getEntry("site", "site"))!.data;
const links = route === undefined ? [] : [
  { href: pathFor("projects", locale), label: copy.nav.projects, key: "projects" },
  { href: pathFor("history", locale), label: copy.nav.history, key: "history" },
  { href: `${pathFor("home", locale)}#join`, label: copy.nav.join, key: "join" },
];
// Each render gets its own pattern id: two marks on one page would otherwise both
// resolve url(#foil) to the first one's pattern.
const uid = Math.random().toString(36).slice(2, 8);
const style = [
  openerStyle(openerLayouts[variant]),
  `--title-band:calc(${titleLines(title)} * ${TITLE_LINE_HEIGHT} * var(--title))`,
  `--mark-x:${formCss(markOrigin[0])}`,
  `--mark-y:${formCss(markOrigin[1])}`,
  `--link-x:${formCss(lockupBox.origin[0])}`,
  `--link-y:${formCss(lockupBox.origin[1])}`,
  `--link-w:${formCss(lockupBox.w)}`,
  `--link-h:${formCss(lockupBox.h)}`,
].join(";");
// The polygons name the zone's own origin, and a custom property resolves its var() references on
// the element it is declared on: they have to sit on the zone, not on the opener.
const polyAbove = `--poly:${polygonCss(shapeAbove)}`;
const polyBelow = `--poly:${polygonCss(shapeBelow)}`;
---
<div class="frame">
  <header class:list={["opener", variant, backdrop && "backdrop"]} style={style} data-foil={variant === "home" ? "" : undefined}>
    {route !== undefined && (
      <a class="lockup-link" href={pathFor("home", locale)} aria-label={site.name}></a>
    )}

    <svg class="ribbon" viewBox={markViewBox} aria-hidden="true">
      <defs set:html={markPattern(uid)} />
      <g fill={`url(#foil-${uid})`}>
        <path d={markRibbonPath} />
        <use href={`#${markPathId}`} />
        <path d={lockupPath} />
      </g>
    </svg>

    {backdrop ? (
      <div class="zone below">
        {route !== undefined && (
          <nav aria-label={copy.nav.mainLabel}>
            {links.map((l) => (
              <a href={l.href} aria-current={l.key === route ? "page" : undefined}>{l.label}</a>
            ))}
            <LocaleSwitch locale={locale} route={route} />
          </nav>
        )}
        <h1 id="main" tabindex="-1">{title}</h1>
        <p class="lead">{lead}</p>
        <slot />
      </div>
    ) : (
      <>
        <div class="zone above" style={polyAbove}>
          <div class="sh"></div>
          {route !== undefined && (
            <nav aria-label={copy.nav.mainLabel}>
              {links.map((l) => (
                <a href={l.href} aria-current={l.key === route ? "page" : undefined}>{l.label}</a>
              ))}
              <LocaleSwitch locale={locale} route={route} />
            </nav>
          )}
          <h1
            id={route === undefined ? undefined : "main"}
            tabindex={route === undefined ? undefined : "-1"}
          >
            {route === undefined && <span class="visually-hidden">{site.name}</span>}
            {title}
          </h1>
        </div>

        <div class="zone below" style={polyBelow}>
          <div class="sh"></div>
          <p class="lead">{lead}</p>
          <slot />
        </div>
      </>
    )}
  </header>
</div>

<script>
  import { watchWedges } from "../lib/wedge";
  watchWedges();
</script>

<style>
  /* The opener is its own query container's child, not the container: an element never answers its
     own container queries, so cqw in --h or the grid's rows would read the viewport (scrollbar
     included) instead of the opener's box. */
  .frame {
    container-type: inline-size;
  }
  .opener {
    --w: 100cqw;
    --by: var(--by-wide);
    --h: var(--h-wide);
    position: relative;
    isolation: isolate;
    display: grid;
    /* Row one is the title's band. It is exactly --below-y while the title fits, so the lead starts
       where the polygon says it does, and it grows — pushing the lead down — when the title needs
       more room than the composition budgeted (a large root font size), rather than being cut. */
    grid-template-rows: minmax(var(--below-y), auto) auto;
    min-block-size: var(--h);
    /* The ribbon runs thousands of user units past the mark's box on both ends; the opener is what
       cuts it to the page, so every end of it lands on a real edge of the document. */
    overflow: hidden;
  }
  /* Under the breakpoint the title takes the whole width, so the lockup moves under it. */
  @container (width < 56rem) {
    .opener {
      --by: var(--by-narrow);
      --h: var(--h-narrow);
    }
  }
  /* Inline-level and in flow: a block-level box would clear the float's whole margin box instead of
     following its shape, and out of flow it could not push the title down when it wraps to a second
     line (which it does at a 32 px root font size). --nav-h is what it reserves when it fits. */
  nav {
    position: relative;
    z-index: 3;
    display: inline-flex;
    vertical-align: top;
    max-inline-size: var(--nav-w);
    min-block-size: var(--nav-h);
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    align-items: start;
  }
  nav a {
    text-decoration: none;
    color: var(--muted);
    padding-block: 0.45rem;
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
  }
  .ribbon {
    position: absolute;
    inset-block-start: var(--mark-y);
    inset-inline-start: var(--mark-x);
    inline-size: var(--m);
    block-size: var(--m);
    /* The arms are drawn well outside the mark's own box: the opener clips them, not the svg. */
    overflow: visible;
    pointer-events: none;
  }
  .zone {
    box-sizing: border-box;
    /* The zones cover the ribbon, so only what carries text or a link takes the pointer. The CTAs
       are slotted in, so this cannot be scoped to the component. */
    pointer-events: none;
  }
  .zone > :global(*) {
    pointer-events: auto;
  }
  .sh {
    float: right;
    pointer-events: none;
    inline-size: 100%;
    shape-outside: var(--poly);
    shape-margin: var(--g);
  }
  .above {
    padding: var(--nav-top) var(--above-x) 0;
    --zone-x: var(--above-x);
    --zone-y: var(--nav-top);
  }
  /* The title's own band, and no more: a grid item contains its float, so a taller float here would
     push the lead down by that much instead of only when the title asks for it. */
  .above .sh {
    block-size: calc(var(--below-y) - var(--nav-top));
  }
  .below {
    padding: 0 var(--above-x) 0 var(--below-x);
    --zone-x: var(--below-x);
    --zone-y: var(--below-y);
  }
  .below .sh {
    float: left;
    block-size: calc(var(--h) - var(--below-y));
  }
  /* base.css balances headings, which counts characters against a rectangle the shape has already
     taken apart; the diagonal is what should set the line lengths. */
  .above h1 {
    /* --above-y is where the title sits when the navigation fits the box it reserves; the rest of
       the distance is the navigation's own height, so a wrapped nav moves the title instead of
       landing on it. */
    margin-block-start: calc(var(--above-y) - var(--nav-top) - var(--nav-h));
    font-size: var(--title);
    /* --title-band, which places the lockup under the title on a narrow opener, assumes this. */
    line-height: 1.02;
    letter-spacing: -0.025em;
    max-width: none;
    color: var(--bright);
    text-wrap: pretty;
    /* At 200% text zoom a single Polish word is wider than a phone viewport. The limits keep the
       hyphen for those and off the ordinary ones: at 400 px the EN title broke as "sci-/ence".
       Chromium reads the first, WebKit the second; Firefox has neither and falls back to plain
       hyphens: auto, which is what shipped before. */
    hyphens: auto;
    hyphenate-limit-chars: 10 4 4;
    -webkit-hyphenate-limit-before: 4;
    overflow-wrap: break-word;
  }
  /* A hyphen in a display line is a defect on a printed sheet, and the sheet's column is wide
     enough for the longest word in either language. */
  .sheet .above h1 {
    hyphens: manual;
  }
  /* The zone's box starts where the diagonal's foot is, so base.css's measure is taken from the
     right margin instead: the block sits there and its line boxes shorten where the float reaches
     in. Ranged right, the lead's ragged edge falls along the word and the foil and its straight edge
     on the margin, mirroring the title on the other side of the ribbon. */
  .below .lead {
    font-size: var(--lead);
    line-height: 1.35;
    /* No measure: the diagonal sets where every line starts, so the lines grow with it all the way
       to the margin; a measure would level the lower ones. */
    max-width: none;
    margin-inline-start: auto;
    text-align: end;
    text-wrap: pretty;
    color: var(--ink);
  }
  /* Over the ribbon, and under the buttons, which carry the same z-index one step up: the title and
     the lead are static, so they stay below it wherever their boxes reach across the diagonal. */
  /* On a page the lockup is a backdrop: dimmed until white copy reads on it, with the navigation,
     the title and the lead in one plain column over it, so the page's content starts where a
     header's would and nothing wraps. The mark still links home. */
  .backdrop .ribbon {
    opacity: 0.25;
  }
  .backdrop .below {
    grid-row: 1;
    display: block;
    padding-block: var(--nav-top) var(--space-5);
  }
  .backdrop nav {
    display: flex;
  }
  .backdrop h1 {
    margin-block-start: var(--space-4);
    font-size: var(--title);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--bright);
    max-width: none;
  }
  .backdrop .below .lead {
    margin-block-start: var(--space-3);
    margin-inline-start: 0;
    max-width: 48ch;
    text-align: start;
  }
  .lockup-link {
    position: absolute;
    inset-block-start: var(--link-y);
    inset-inline-start: var(--link-x);
    inline-size: var(--link-w);
    block-size: var(--link-h);
    z-index: 1;
  }
  /* The ring runs across the foil, which is as light as --bright: on its own it measures 1.3:1
     there. Filling the outline's offset with --bg gives it a 3:1 neighbour the whole way round. */
  .lockup-link:focus-visible {
    box-shadow: 0 0 0 3px var(--bg);
  }
</style>
