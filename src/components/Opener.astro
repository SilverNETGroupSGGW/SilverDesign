---
import { getEntry } from "astro:content";
import FolderCode from "lucide-static/icons/folder-code.svg";
import History from "lucide-static/icons/history.svg";
import UserPlus from "lucide-static/icons/user-plus.svg";
import { pathFor, type Locale, type RouteKey } from "../lib/i18n";
import { lockupPath, lockupTightBox } from "../lib/lockup";
import {
  markAxis,
  markBandPath,
  markPathId,
  markPattern,
  markRibbonPath,
  markTopBarKeep,
  markTopBarPath,
  markViewBox,
} from "../lib/mark";
import {
  backdropVariants,
  formCss,
  markOrigin,
  openerLayouts,
  openerStyle,
  polygonCss,
  shapeAbove,
  shapeBelow,
  TITLE_LINE_HEIGHT,
  unroll,
  UNROLL_ARM_LENGTH,
  titleLines,
} from "../lib/opener";
import LocaleSwitch from "./LocaleSwitch.astro";

interface Props {
  locale: Locale;
  variant: "home" | "page" | "sheet";
  title: string;
  lead: string;
  /** Given for a page of the site, which carries the navigation. */
  route?: RouteKey;
}
const { locale, variant, title, lead, route } = Astro.props;
const backdrop = backdropVariants.has(variant);
const copy = (await getEntry("copy", locale))!.data;
const site = (await getEntry("site", "site"))!.data;
const links = route === undefined ? [] : [
  { href: pathFor("projects", locale), label: copy.nav.projects, key: "projects", Icon: FolderCode },
  { href: pathFor("history", locale), label: copy.nav.history, key: "history", Icon: History },
  { href: `${pathFor("home", locale)}#join`, label: copy.nav.join, key: "join", Icon: UserPlus },
];
// Each render gets its own pattern id: two marks on one page would otherwise both
// resolve url(#foil) to the first one's pattern.
const uid = Math.random().toString(36).slice(2, 8);
const style = [
  openerStyle(openerLayouts[variant]),
  `--title-band:calc(${titleLines(title)} * ${TITLE_LINE_HEIGHT} * var(--title))`,
  `--mark-x:${formCss(markOrigin[0])}`,
  `--mark-y:${formCss(markOrigin[1])}`,
].join(";");
// The polygons name the zone's own origin, and a custom property resolves its var() references on
// the element it is declared on: they have to sit on the zone, not on the opener.
// The top bar's lockup box is the S and the word: the row centres on those, and the bar's horizontal
// run hangs below the row.
const logoStyle = `--box-x:${lockupTightBox.x};--box-y:${lockupTightBox.y};--box-w:${lockupTightBox.w};--box-h:${lockupTightBox.h}`;
// The S and the word on their own, cut to the lockup's tight box: the element that flies between the
// hero and the navigation's corner when the page changes (Base.astro). On the home page it sits over
// the hero's lockup, a fraction of --m in from the mark box's corner.
const { x: tx, y: ty, w: tw, h: th } = lockupTightBox;
const tightViewBox = `${tx} ${ty} ${tw} ${th}`;
const [mvx, mvy, mvs] = markViewBox.split(" ").map(Number) as [number, number, number];
const heroLockupStyle = `--lx:${(tx - mvx) / mvs};--ly:${(ty - mvy) / mvs};--lw:${tw / mvs};--lh:${th / mvs}`;
const besideLockup = `M -30000 -30000 H 30000 V 30000 H -30000 Z M ${tx} ${ty} h ${tw} v ${th} h ${-tw} Z`;
/** In mark units: how far the unroll's strokes and the word's lane reach past what they uncover. */
const UNROLL_MARGIN = 8;
const SPINE_WIDTH = unroll.lineWidth + UNROLL_MARGIN;
/** Longer than any path position the tip takes, rest included (Opener's CSS, --unroll-tip). */
const UNROLL_DASH = 100000;
const { centre, dir, half, lower, upper, spineLength, wordEnd } = unroll;
const frame = { centre, dir, half, lower, upper, spineLength, wordEnd };
const polyAbove = `--poly:${polygonCss(shapeAbove)}`;
const polyBelow = `--poly:${polygonCss(shapeBelow)}`;
---
<div class="frame">
  <header class:list={["opener", variant, backdrop && "backdrop"]} style={style} data-foil={variant === "home" ? markAxis.join(" ") : undefined}>
    <svg
      class="ribbon"
      viewBox={markViewBox}
      aria-hidden="true"
      style={variant === "home" ? `--beside-lockup:url(#beside-lockup-${uid})` : undefined}
    >
      <defs set:html={markPattern(uid)} />
      {/* The ribbon unrolls onto the home page from the left edge, and the S is drawn as the band
          runs through it: a wide stroke up the lower arm, a line-width stroke along the S's spine,
          a wide stroke out along the upper arm, and the word uncovered in its own lane as the upper
          arm passes over it. One custom property, the tip's position on that path, moves all four,
          so the tip never jumps between them. The arm strokes stop square at the joints, where the
          S's halves do not reach, and the word's lane holds nothing else past the S. */}
      {variant === "home" && (
        <defs>
          <clipPath id={`beside-lockup-${uid}`}>
            <path d={besideLockup} clip-rule="evenodd" />
          </clipPath>
          <clipPath id={`word-lane-${uid}`}>
            <rect
              x={unroll.wordStart - UNROLL_MARGIN}
              y={unroll.wordAcross[0] - UNROLL_MARGIN}
              width="60000"
              height={unroll.wordAcross[1] - unroll.wordAcross[0] + 2 * UNROLL_MARGIN}
            />
          </clipPath>
          <mask
            id={`unroll-${uid}`}
            class="unroll"
            style={`--spine-length:${unroll.spineLength};--upper-along:${unroll.upperAlong};--arm-length:${UNROLL_ARM_LENGTH};--dash:${UNROLL_DASH}`}
            data-unroll={JSON.stringify(frame)}
          >
            <g fill="none" stroke="#fff" stroke-dasharray={`${UNROLL_DASH} ${UNROLL_DASH}`}>
              <path class="arm-in" d={unroll.lowerArm} stroke-width={unroll.half * 2 + 2 * UNROLL_MARGIN} />
              <path class="spine" d={unroll.spinePath} stroke-width={SPINE_WIDTH} stroke-linejoin="round" />
              <path class="arm-out" d={unroll.upperArm} stroke-width={unroll.half * 2 + 2 * UNROLL_MARGIN} />
            </g>
            <g
              transform={`translate(${unroll.centre.join(" ")}) rotate(${unroll.angle})`}
              clip-path={`url(#word-lane-${uid})`}
            >
              <rect class="word" x="-60000" y="-25000" width="60000" height="50000" fill="#fff" />
            </g>
          </mask>
        </defs>
      )}
      <g fill={`url(#foil-${uid})`} mask={variant === "home" ? `url(#unroll-${uid})` : undefined}>
        {backdrop ? (
          <path d={markBandPath} />
        ) : (
          <>
            <path d={markRibbonPath} />
            <use class="lockup-part" href={`#${markPathId}`} />
            <path class="lockup-part" d={lockupPath} />
          </>
        )}
      </g>
    </svg>
    {variant === "home" && (
      <svg class="lockup-vt" viewBox={tightViewBox} style={heroLockupStyle} aria-hidden="true">
        <g fill={`url(#foil-${uid})`}>
          <use href={`#${markPathId}`} />
          <path d={lockupPath} />
        </g>
      </svg>
    )}

    {backdrop ? (
      <div class="zone below">
        {route !== undefined && (
          <nav aria-label={copy.nav.mainLabel}>
            <a class="logo" href={pathFor("home", locale)} aria-label={site.name} style={logoStyle}>
              <svg class="mark" viewBox={markViewBox} aria-hidden="true">
                {/* The hero draws the mark about eight times larger; at the logo's own scale the texture
                    tiles every few dozen pixels and reads as a repeat along the bar. Past 3× the
                    highlights no longer fit on the logo and it turns flat grey. */}
                <defs>
                  <Fragment set:html={markPattern(`${uid}-logo`, 3)} />
                  <clipPath id={`bar-${uid}`}>
                    <polygon points={markTopBarKeep} />
                  </clipPath>
                </defs>
                <g fill={`url(#foil-${uid}-logo)`}>
                  <path d={markTopBarPath} />
                  <use class="lockup-part" href={`#${markPathId}`} clip-path={`url(#bar-${uid})`} />
                  <path class="lockup-part" d={lockupPath} />
                </g>
              </svg>
              <svg class="lockup-vt" viewBox={tightViewBox} aria-hidden="true">
                <g fill={`url(#foil-${uid}-logo)`}>
                  <use href={`#${markPathId}`} clip-path={`url(#bar-${uid})`} />
                  <path d={lockupPath} />
                </g>
              </svg>
            </a>
            {links.map((l) => (
              <a href={l.href} aria-current={l.key === route ? "page" : undefined}>
                <l.Icon class="icon" aria-hidden="true" /><span class="label">{l.label}</span>
              </a>
            ))}
            <LocaleSwitch locale={locale} route={route} icon />
          </nav>
        )}
        <h1 id="main" tabindex="-1">{title}</h1>
        <p class="lead">{lead}</p>
        <slot />
      </div>
    ) : (
      <>
        <div class="zone above" style={polyAbove}>
          <div class="sh"></div>
          {route !== undefined && (
            <nav aria-label={copy.nav.mainLabel}>
              {links.map((l) => (
                <a href={l.href} aria-current={l.key === route ? "page" : undefined}>
                <l.Icon class="icon" aria-hidden="true" /><span class="label">{l.label}</span>
              </a>
              ))}
              <LocaleSwitch locale={locale} route={route} icon />
            </nav>
          )}
          <h1
            id={route === undefined ? undefined : "main"}
            tabindex={route === undefined ? undefined : "-1"}
          >
            {route === undefined && <span class="visually-hidden">{`${site.name} — `}</span>}
            {title}
          </h1>
        </div>

        <div class="zone below" style={polyBelow}>
          <div class="sh"></div>
          <p class="lead">{lead}</p>
          <slot />
        </div>
      </>
    )}
  </header>
</div>

<script>
  import { watchWedges } from "../lib/wedge";
  watchWedges();
</script>

<style>
  /* The opener is its own query container's child, not the container: an element never answers its
     own container queries, so cqw in --h or the grid's rows would read the viewport (scrollbar
     included) instead of the opener's box. */
  .frame {
    container-type: inline-size;
    /* The backdrop opener trades overflow for a clip path, and a clip path hides the band's paint
       without taking its box out of the scrollable overflow region: at 200% text zoom the svg's
       right edge scrolled a phone sideways. Clipping here contains the box, and block-direction
       overflow stays visible, so the band still runs on under the content. */
    overflow-x: clip;
  }
  /* The English labels fit one line down to a narrower row than the Polish ones. A container query
     cannot read a custom property, but its em is the container's font size: this moves the fold's
     30.75em bound to 28.25rem in English, and the opener takes the root size back. */
  .frame:lang(en) {
    font-size: calc(28.25rem / 30.75);
  }
  .opener {
    font-size: 1rem;
    --w: 100cqw;
    --by: var(--by-wide);
    --h: var(--h-wide);
    position: relative;
    isolation: isolate;
    display: grid;
    /* Row one is the title's band. It is exactly --below-y while the title fits, so the lead starts
       where the polygon says it does, and it grows — pushing the lead down — when the title needs
       more room than the composition budgeted (a large root font size), rather than being cut. */
    grid-template-rows: minmax(var(--below-y), auto) auto;
    grid-template-columns: minmax(0, 1fr);
    min-block-size: var(--h);
    /* The ribbon runs thousands of user units past the mark's box on both ends; the opener is what
       cuts it to the page, so every end of it lands on a real edge of the document. */
    overflow: hidden;
  }
  /* Under the breakpoint the title takes the whole width, so the lockup moves under it. */
  @container (width < 56rem) {
    .opener {
      --by: var(--by-narrow);
      --h: var(--h-narrow);
    }
  }
  /* Inline-level and in flow: a block-level box would clear the float's whole margin box instead of
     following its shape, and out of flow it could not push the title down when it wraps to a second
     line (which it does at a 32 px root font size). --nav-h is what it reserves when it fits. */
  nav {
    position: relative;
    z-index: 3;
    display: inline-flex;
    vertical-align: top;
    max-inline-size: var(--nav-w);
    min-block-size: var(--nav-h);
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    align-items: start;
  }
  /* Four labels have to share the --nav-w box, and at the site's column gap the switch wrapped onto
     a row of its own at 360 px and below — one line above the headline, where it reads as a kicker
     rather than as a control. The gaps take what the box has left after the labels (15rem covers
     the wider locale's row, Polish at 224 px on a 16 px root, with room to spare) and give it back
     from 400 px up, where the full gap fits again. */
  .opener:not(.backdrop) nav {
    column-gap: clamp(var(--space-2), (var(--nav-w) - 15rem) / 3, var(--space-4));
  }
  nav a {
    text-decoration: none;
    color: var(--muted);
    padding-block: 0.45rem;
    transition: color 120ms;
  }
  nav a:not(.logo),
  nav :global(.switch) {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
  }
  nav :global(.icon) {
    inline-size: 1.1em;
    block-size: 1.1em;
    flex: none;
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
  }
  .ribbon {
    position: absolute;
    inset-block-start: var(--mark-y);
    inset-inline-start: var(--mark-x);
    inline-size: var(--m);
    block-size: var(--m);
    /* The arms are drawn well outside the mark's own box: the opener clips them, not the svg. */
    overflow: visible;
    pointer-events: none;
  }
  .zone {
    box-sizing: border-box;
    /* The zones cover the ribbon, so only what carries text or a link takes the pointer. The CTAs
       are slotted in, so this cannot be scoped to the component. */
    pointer-events: none;
  }
  .zone > :global(*) {
    pointer-events: auto;
  }
  .sh {
    float: right;
    pointer-events: none;
    inline-size: 100%;
    shape-outside: var(--poly);
    shape-margin: var(--g);
  }
  .above {
    padding: var(--nav-top) var(--above-x) 0;
    --zone-x: var(--above-x);
    --zone-y: var(--nav-top);
  }
  /* The title's own band, and no more: a grid item contains its float, so a taller float here would
     push the lead down by that much instead of only when the title asks for it. */
  .above .sh {
    block-size: calc(var(--below-y) - var(--nav-top));
  }
  .below {
    padding: 0 var(--above-x) 0 var(--below-x);
    --zone-x: var(--below-x);
    --zone-y: var(--below-y);
  }
  .below .sh {
    float: left;
    block-size: calc(var(--h) - var(--below-y));
  }
  /* base.css balances headings, which counts characters against a rectangle the shape has already
     taken apart; the diagonal is what should set the line lengths. */
  .above h1 {
    /* --above-y is where the title sits when the navigation fits the box it reserves; the rest of
       the distance is the navigation's own height, so a wrapped nav moves the title instead of
       landing on it. */
    margin-block-start: calc(var(--above-y) - var(--nav-top) - var(--nav-h));
    font-size: var(--title);
    /* --title-band, which places the lockup under the title on a narrow opener, assumes this. */
    line-height: 1.02;
    letter-spacing: -0.025em;
    max-width: none;
    color: var(--bright);
    text-wrap: pretty;
    /* At 200% text zoom a single Polish word is wider than a phone viewport. The limits keep the
       hyphen for those and off the ordinary ones: at 400 px the EN title broke as "sci-/ence".
       Chromium reads the first, WebKit the second; Firefox has neither and falls back to plain
       hyphens: auto, which is what shipped before. */
    hyphens: auto;
    hyphenate-limit-chars: 10 4 4;
    -webkit-hyphenate-limit-before: 4;
    overflow-wrap: break-word;
  }
  /* A hyphen in a display line is a defect on a printed sheet, and the sheet's column is wide
     enough for the longest word in either language. */
  .sheet .above h1 {
    hyphens: manual;
  }
  /* The zone's box starts where the diagonal's foot is, so base.css's measure is taken from the
     right margin instead: the block sits there and its line boxes shorten where the float reaches
     in. Ranged right, the lead's ragged edge falls along the word and the foil and its straight edge
     on the margin, mirroring the title on the other side of the ribbon. */
  .below .lead {
    font-size: var(--lead);
    line-height: 1.35;
    /* No measure: the diagonal sets where every line starts, so the lines grow with it all the way
       to the margin; a measure would level the lower ones. */
    max-width: none;
    margin-inline-start: auto;
    text-align: end;
    text-wrap: pretty;
    color: var(--ink);
  }
  /* Over the ribbon, and under the buttons, which carry the same z-index one step up: the title and
     the lead are static, so they stay below it wherever their boxes reach across the diagonal. */
  /* On a page the lockup is a backdrop: dimmed until white copy reads on it, with the navigation,
     the title and the lead in one plain column over it, so the page's content starts where a
     header's would and nothing wraps. The mark still links home. */
  .backdrop .ribbon {
    opacity: 0.25;
  }
  /* The band passes behind this row, and --muted over its brightest pixels measures 3.5:1: the
     icons keep the home page's quieter grey, the labels step up to ink, which clears 4.5:1. */
  .backdrop nav :global(.label) {
    color: var(--ink);
    transition: color 120ms;
  }
  .backdrop nav a:hover :global(.label),
  .backdrop nav a[aria-current="page"] :global(.label) {
    color: var(--bright);
  }
  /* The page's header is only as tall as its copy; the dimmed ribbon keeps going under the content
     that follows until it leaves through the page's left edge on its own. The clip still cuts it at
     the top and the sides, so nothing widens the document. */
  .backdrop {
    overflow: visible;
    clip-path: inset(0 0 -200vh 0);
  }
  .backdrop .below {
    grid-row: 1;
    display: block;
    padding-block: var(--nav-top) var(--space-5);
  }
  /* The band may pass behind the links on a page, so the navigation takes the row it needs. */
  .backdrop nav {
    display: flex;
    align-items: center;
    max-inline-size: none;
  }
  /* The lockup heads the navigation on a page and the row centres on it, so the links sit level
     with the middle of the word. The link is the lockup's box (--box-*, in mark units: the S and
     the word); the svg is the whole 600-unit mark box placed so that box fills the link, and its
     ribbon runs out of it: up to the top edge, and left along the bar's bottom edge, below the row,
     to the left edge, where the opener's clip ends both. */
  .backdrop .logo {
    --logo-h: 3rem;
    --unit: calc(var(--logo-h) / var(--box-h));
    position: relative;
    display: block;
    block-size: var(--logo-h);
    inline-size: calc(var(--unit) * var(--box-w));
    margin-inline-end: var(--space-2);
  }
  /* The lockup is 2.1rem tall on a phone; the hit area reaches 44 px without moving the row. */
  .backdrop .logo::after {
    content: "";
    position: absolute;
    inset: min(0px, (var(--logo-h) - 2.75rem) / 2) 0;
  }
  /* Five items and the lockup do not fit a phone's row at the site's gaps; tighter, they just do. */
  @container (width < 40rem) {
    .backdrop nav {
      gap: var(--space-2) var(--space-3);
    }
    .backdrop .logo {
      --logo-h: 2.1rem;
      /* No margin of its own: the row's gap is the space, and four more pixels cost a third row
         between 399 and 402 px. */
      margin-inline-end: 0;
    }
  }
  /* Where the links would wrap onto a second row, each becomes a column, the icon over a short
     label, decided here rather than in script so the first paint already has it. The bounds are in
     rem, measured with the one-line row wrapping below 30.06rem in Polish and 27.63rem in English and
     the folded row fitting from 17.75rem with the lockup (14.3rem without it), both with room for
     another engine's text metrics. Below the fold's floor, which large text reaches on a phone, the
     links wrap as they did before the fold existed: a row that cannot shrink would scroll the page.
     The columns are equal, not spaced evenly: the labels differ in length, and even gaps between
     unequal boxes set the icons at uneven distances. The margins take back the links' own padding so
     the outer columns stand as far from their page edges as each other. The --nav-w budget is for
     the one-line labels; this row is short enough to clear the band across the full width. */
  @container (18.25rem <= width < 30.75em) {
    nav {
      --pad: 0.1rem;
      inline-size: calc(100% + 2 * var(--pad));
      max-inline-size: none;
      margin-inline: calc(-1 * var(--pad));
      flex-wrap: nowrap;
      column-gap: 0;
    }
    /* On a page the lockup leads, with no padding of its own, from the zone's left inset, which is
       narrower than its right one. The equal columns are the only spacing. */
    .backdrop nav {
      inline-size: auto;
      margin-inline: 0 calc(var(--below-x) - var(--above-x) - var(--pad));
      column-gap: 0;
    }
    nav a:not(.logo),
    nav :global(.switch) {
      flex: 1 1 0;
      min-inline-size: 0;
      flex-direction: column;
      gap: 0.2rem;
      padding: 0.35rem var(--pad);
      font-family: inherit;
      font-size: 0.8rem;
    }
    nav :global(.icon) {
      inline-size: 1.45rem;
      block-size: 1.45rem;
    }
    .backdrop nav .logo {
      margin-inline-end: var(--space-3);
    }
  }
  .backdrop .logo .mark {
    position: absolute;
    inline-size: calc(var(--unit) * 600);
    block-size: calc(var(--unit) * 600);
    inset-inline-start: calc(var(--unit) * (300 - var(--box-x)));
    inset-block-start: calc(var(--unit) * (300 - var(--box-y)));
    overflow: visible;
    pointer-events: none;
  }
  /* The home page's arrival, in the order it is read: the lockup, the title, the lead, and the
     navigation last. Not replayed when the visitor comes back from another page of the site
     (Base.astro sets data-hero="still"). The buttons are slotted, so Home.astro times them. */
  /* --unroll-tip is the tip's position on its path (see the mask above); each stroke shows the part
     of itself behind the tip, and the word's lane is uncovered up to the tip's place along the upper
     arm. Its resting value lies past the end of every stroke. --unroll-from and --unroll-to are the
     tip's run for the viewport (unroll.ts); the fallbacks cover a desktop opener, so without the
     script the tip only spends a few more frames beyond the left edge. */
  @property --unroll-tip {
    syntax: "<number>";
    inherits: true;
    initial-value: 40000;
  }
  .unroll .arm-in {
    stroke-dashoffset: calc((var(--dash) - var(--arm-length) - var(--unroll-tip)) * 1px);
  }
  .unroll .spine {
    stroke-dashoffset: calc((var(--dash) - var(--unroll-tip)) * 1px);
  }
  .unroll .arm-out {
    stroke-dashoffset: calc((var(--dash) + var(--spine-length) - var(--unroll-tip)) * 1px);
  }
  .unroll .word {
    transform: translateX(
      calc((var(--upper-along) + var(--unroll-tip) - var(--spine-length)) * 1px)
    );
  }
  :global(:root:not([data-hero="still"])) .home .ribbon {
    animation: ribbon-unroll 1100ms cubic-bezier(0.3, 0.55, 0.3, 1) both;
  }
  :global(:root:not([data-hero="still"])) .home .above h1 {
    animation: axis-in 800ms var(--ease-out) 650ms both;
  }
  :global(:root:not([data-hero="still"])) .home .below .lead {
    animation: axis-in 800ms var(--ease-out) 850ms both;
  }
  :global(:root:not([data-hero="still"])) .home nav {
    animation: fade-in 600ms ease-out 1130ms both;
  }
  @keyframes ribbon-unroll {
    from {
      --unroll-tip: var(--unroll-from, -2000);
    }
    to {
      --unroll-tip: var(--unroll-to, 2100);
    }
  }
