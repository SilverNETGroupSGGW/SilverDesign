---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../lib/i18n";
import { wheels } from "../lib/odometer";
import { historyStart } from "../lib/schemas";

interface Props {
  entries: CollectionEntry<"history">[];
  locale: Locale;
}
const { entries, locale } = Astro.props;
const sorted = entries.toSorted(
  (a, b) => historyStart(a.data) - historyStart(b.data) || a.data.order - b.data.order,
);
type Entry = CollectionEntry<"history">["data"];
const label = (d: Entry) => ("year" in d ? String(d.year) : `${d.yearFrom}–${d.yearTo}`);
const end = (d: Entry) => ("year" in d ? d.year : d.yearTo);
const years = sorted.map((e, i) => {
  const start = String(historyStart(e.data));
  const before = i === 0 ? start : String(end(sorted[i - 1]!.data));
  const parts = [{ lag: 0, wheels: wheels(before, start) }];
  if (!("year" in e.data)) parts.push({ lag: 1, wheels: wheels(start, String(e.data.yearTo)) });
  return parts;
});
const DIGITS = [..."01234567890123456789"];
---
<ol class="timeline" role="list">
  {sorted.map((e, i) => (
    <li data-reveal>
      <span class="year mono">
        <span class="visually-hidden">{label(e.data)}</span>
        <span class="odo" aria-hidden="true">
          {years[i]!.map((part, p) => (
            <span class:list={["part", p > 0 && "later"]}>
              {p > 0 && <span>–</span>}
              {part.wheels.map((w) => (
                <span class="wheel" style={`--from:${w.from};--to:${w.to};--ticks:${w.ticks};--lag:${part.lag}`}>
                  {DIGITS.map((d) => <span>{d}</span>)}
                </span>
              ))}
            </span>
          ))}
        </span>
      </span>
      <div>
        <h2>{e.data.title[locale]}</h2>
        <p>{e.data.body[locale]}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }
  li {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-4);
    align-items: start;
  }
  .year {
    color: var(--muted);
    padding-top: 0.35em;
    font-variant-numeric: tabular-nums;
  }
  div {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding-bottom: var(--space-5);
  }
  /* The divider carries the corner cut the cards carry: it lifts at --angle over its last --cut. */
  div::before,
  div::after {
    content: "";
    position: absolute;
    bottom: 0;
    block-size: 1px;
    background: var(--line);
  }
  div::before {
    left: 0;
    right: var(--cut);
  }
  div::after {
    left: calc(100% - var(--cut));
    inline-size: calc(var(--cut) / cos(var(--angle)));
    transform-origin: 0 100%;
    transform: rotate(calc(-1 * var(--angle)));
  }
  h2 {
    font-size: var(--step-1);
  }
  p {
    color: var(--muted);
  }
  .odo {
    --cell: 1.5em;
    display: inline-flex;
    block-size: var(--cell);
    line-height: var(--cell);
    overflow: hidden;
    user-select: none;
  }
  .part {
    display: inline-flex;
  }
  .wheel {
    display: flex;
    flex-direction: column;
    translate: 0 calc(var(--to) * -1 * var(--cell));
  }
  @property --row {
    syntax: "<percentage>";
    inherits: true;
    initial-value: 130%;
  }
  li {
    --reveal-gap: 280ms;
    position: relative;
    isolation: isolate;
  }
  li[data-reveal="in"] {
    animation: row-in 1300ms cubic-bezier(0.3, 0.1, 0.25, 1) both;
    mask-image: linear-gradient(
      calc(180deg - var(--angle)),
      #000 calc(var(--row) - 15%),
      transparent var(--row)
    );
  }
  li[data-reveal="in"]::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      calc(180deg - var(--angle)),
      transparent calc(var(--row) - 30%),
      color-mix(in srgb, var(--ink) 8%, transparent) calc(var(--row) - 10%),
      transparent var(--row)
    );
  }
  li[data-reveal="in"] .wheel {
    animation: roll calc(450ms + var(--ticks) * 180ms) var(--ease-out)
      calc(120ms + var(--lag) * 450ms) both;
  }
  li[data-reveal="in"] .later {
    animation: fade-in 200ms ease-out 570ms both;
  }
  @keyframes row-in {
    from {
      --row: 0%;
    }
    to {
      --row: 130%;
    }
  }
  @keyframes roll {
    from {
      translate: 0 calc(var(--from) * -1 * var(--cell));
    }
  }
  @media (max-width: 40rem) {
    li {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
