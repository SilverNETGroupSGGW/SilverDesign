---
import { getEntry } from "astro:content";
import type { Locale } from "../lib/i18n";
import Button from "./Button.astro";

interface Props {
  locale: Locale;
  text: string;
}
const { locale, text } = Astro.props;
const copy = (await getEntry("copy", locale))!.data;
const site = (await getEntry("site", "site"))!.data;
---
<section class="strip container cut" aria-label={copy.join.heading} data-reveal>
  <p data-motion="read">{text}</p>
  <Button href={site.discord}>{copy.hero.ctaDiscord}</Button>
</section>

<style>
  .strip {
    margin-block: var(--space-6);
    padding: var(--space-5);
    background: var(--surface);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .strip {
    --reveal-gap: 350ms;
  }
  .strip[data-reveal="in"] {
    animation: cut-in 900ms var(--ease-out) both;
  }
  .strip[data-reveal="in"] > p {
    --read-after: 300ms;
  }
  .strip[data-reveal="in"] :global(.primary)::before {
    animation: cut-in 600ms var(--ease-out) 600ms both;
  }
  .strip[data-reveal="in"] :global(.primary .label) {
    animation: fade-in 250ms ease-out 850ms both;
  }
  p {
    font-size: var(--step-1);
    max-width: 46ch;
    min-inline-size: 0;
    hyphens: auto;
    overflow-wrap: anywhere;
  }
</style>
