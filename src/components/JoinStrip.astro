---
import { getEntry } from "astro:content";
import type { Locale } from "../lib/i18n";
import Button from "./Button.astro";

interface Props {
  locale: Locale;
  text: string;
}
const { locale, text } = Astro.props;
const copy = (await getEntry("copy", locale))!.data;
const site = (await getEntry("site", "site"))!.data;
---
<section class="strip container cut" aria-label={copy.join.heading}>
  <p>{text}</p>
  <Button href={site.discord}>{copy.hero.ctaDiscord}</Button>
</section>

<style>
  .strip {
    margin-block: var(--space-6);
    padding: var(--space-5);
    background: var(--surface);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  p {
    font-size: var(--step-1);
    max-width: 46ch;
  }
</style>
