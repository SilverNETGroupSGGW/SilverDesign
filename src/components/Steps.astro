---
import type { Copy } from "../lib/schemas";

interface Props {
  steps: Copy["steps"];
  /** Where the first step leads; given, that step becomes the page's primary action. */
  firstHref?: string;
}
const { steps, firstHref } = Astro.props;
---
<div class="steps">
  <ol role="list" aria-label={steps.heading}>
    {steps.items.map((s, i) => (
      <li class:list={i === 0 && firstHref ? ["primary", "cut-fill"] : ["cut"]} data-reveal>
        <span class="n mono">0{i + 1}</span>
        {i === 0 && firstHref ? (
          <h3><a class="go" href={firstHref}>{s.title}<span aria-hidden="true"> →</span></a></h3>
        ) : (
          <h3>{s.title}</h3>
        )}
        <p>{s.body}</p>
      </li>
    ))}
  </ol>
</div>

<style>
  .steps {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
  }
  li {
    position: relative;
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--line);
    display: grid;
    align-content: start;
    gap: var(--space-2);
    grid-template-columns: minmax(0, 1fr);
  }
  .n {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  h3 {
    font-size: var(--step-1);
  }
  li {
    --reveal-gap: 260ms;
  }
  li::after {
    content: "";
    position: absolute;
    inset: -1px -1px auto;
    block-size: 2px;
    background: var(--bright);
    opacity: 0;
    pointer-events: none;
  }
  li[data-reveal="in"] {
    animation: fade-in 500ms ease-out both;
  }
  li[data-reveal="in"]::after {
    animation: step-line 1100ms var(--ease-out) 60ms both;
  }
  li[data-reveal="in"] > * {
    animation: fade-in 450ms ease-out 200ms both;
  }
  li[data-reveal="in"] > h3 {
    animation-delay: 280ms;
  }
  li[data-reveal="in"] > p {
    animation-delay: 360ms;
  }
  @keyframes step-line {
    0% {
      clip-path: inset(0 100% 0 0);
      opacity: 1;
    }
    55% {
      clip-path: inset(0);
      opacity: 1;
    }
    100% {
      clip-path: inset(0);
      opacity: 0;
    }
  }
  p {
    color: var(--muted);
  }
  /* The primary button's fill on a whole step: cut on the pseudo-element, so the focus ring around
     the step is not cut with it. */
  .primary {
    isolation: isolate;
    border-color: transparent;
    color: var(--bg);
  }
  .primary::before {
    content: "";
    position: absolute;
    inset: -1px;
    z-index: -1;
    background: var(--ink);
    transition: background-color 120ms;
  }
  .primary:hover::before {
    background: var(--bright);
  }
  /* 5.7 : 1 on Chrome Silver, 7.1 : 1 on Polished Highlight. */
  .primary .n,
  .primary p {
    color: color-mix(in srgb, var(--bg) 70%, var(--ink));
  }
  .go {
    color: inherit;
    text-decoration: none;
  }
  .go::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .go:focus-visible {
    outline: none;
  }
  .primary:has(.go:focus-visible) {
    outline: 2px solid var(--bright);
    outline-offset: 3px;
  }
</style>
