---
import { getEntry } from "astro:content";
import { fill, pathFor, type Locale, type RouteKey } from "../lib/i18n";
import LocaleSwitch from "./LocaleSwitch.astro";

interface Props {
  locale: Locale;
  route: RouteKey;
}
const { locale, route } = Astro.props;
const copy = (await getEntry("copy", locale))!.data;
const site = (await getEntry("site", "site"))!.data;
---
<footer class="footer">
  <div class="container grid">
    <div>
      <p class="name">{site.formalName}</p>
      <p class="muted"><a href={pathFor("history", locale)}>{fill(copy.footer.since, { year: site.since })}</a></p>
    </div>
    <div>
      <p class="label">{copy.footer.contact}</p>
      <p class="mono"><a href={`mailto:${site.email}`}>{site.email}</a></p>
      {site.address.map((line) => <p class="mono muted">{line}</p>)}
      <p class="mono muted">{copy.join.room} {site.room}</p>
    </div>
    <div class="linkcol">
      <p class="label">{copy.footer.links}</p>
      <p><a href={site.discord}>Discord</a></p>
      <p><a href={site.github}>GitHub</a></p>
      <p><a href={site.facebook}>Facebook</a></p>
      <p><LocaleSwitch locale={locale} route={route} /></p>
    </div>
  </div>
</footer>

<style>
  /* The cut's run scales with the element it cuts; only the angle is fixed. */
  .footer {
    --cut: 6rem;
    position: relative;
    isolation: isolate;
    margin-top: var(--space-7);
    padding-block: var(--space-6);
  }
  /* Two stacked planes one pixel apart: the lower one shows through as a --line edge that follows
     the cut, which a border or a single clipped plane cannot do along a diagonal. */
  .footer::before,
  .footer::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset-inline: 0;
    inset-block-end: 0;
    clip-path: polygon(
      0 calc(var(--cut) * tan(var(--angle))),
      var(--cut) 0,
      100% 0,
      100% 100%,
      0 100%
    );
  }
  .footer::before {
    inset-block-start: 0;
    background: var(--line);
  }
  .footer::after {
    inset-block-start: 1px;
    background: var(--surface);
  }
  .grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
  }
  .name {
    font-weight: 600;
  }
  .label {
    color: var(--muted);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-2);
  }
  .muted {
    color: var(--muted);
  }
  .footer a {
    padding-block: 0.45rem;
  }
  /* The padded link boxes in this column would otherwise overlap each other vertically. */
  .linkcol p:not(.label) + p {
    margin-top: var(--space-2);
  }
  @media (pointer: coarse) {
    .linkcol a,
    .linkcol :global(.switch),
    .mono a {
      display: inline-flex;
      align-items: center;
      min-block-size: 2.75rem;
      padding-block: 0;
    }
    .linkcol p:not(.label) + p {
      margin-top: 0;
    }
  }
</style>
