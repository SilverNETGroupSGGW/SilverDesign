---
import type { Locale } from "../lib/i18n";
import type { Copy } from "../lib/schemas";

interface Props {
  copy: Copy["projects"];
  locale: Locale;
}
const { copy, locale } = Astro.props;
// The query string is part of the page's URL vocabulary, so it is localised like the routes are.
const query = {
  pl: { param: "filtr", store: "sklep", github: "github" },
  en: { param: "filter", store: "store", github: "github" },
} as const;
const { param, ...slugs } = query[locale];
const options = [
  { value: "all", label: copy.filterAll },
  { value: "store", label: copy.filterStore, slug: slugs.store },
  { value: "github", label: copy.filterGithub, slug: slugs.github },
];
---
{/* Hidden until the script upgrades it: without JavaScript the pills answer nothing, and a
    pressed state no click can change is a claim the page cannot keep. */}
<div class="filter" role="group" aria-label={copy.filterLabel} data-project-filter data-param={param} hidden>
  {options.map((o, i) => (
    <button type="button" class="cut-fill" data-value={o.value} data-slug={o.slug} aria-pressed={i === 0 ? "true" : "false"}>
      {o.label}
    </button>
  ))}
  <p class="visually-hidden" role="status" aria-live="polite" data-filter-status data-count={copy.filterCount}></p>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-project-filter]");
  root?.removeAttribute("hidden");
  const status = root?.querySelector<HTMLElement>("[data-filter-status]");
  const cards = document.querySelectorAll<HTMLElement>("[data-status]");
  const param = root?.dataset.param ?? "filter";

  const apply = (value: string) => {
    if (!root) return;
    let shown = 0;
    for (const card of cards) {
      card.hidden = value !== "all" && card.dataset.status !== value;
      if (!card.hidden) shown += 1;
    }
    for (const b of root.querySelectorAll("button")) {
      b.setAttribute("aria-pressed", String(b.dataset.value === value));
    }
    if (status) {
      status.textContent = (status.dataset.count ?? "")
        .replace("{count}", String(shown))
        .replace("{total}", String(cards.length));
    }
  };

  // The filter is the only state this page has, and it is all in the query string: a new entry per
  // change makes Back undo one, and every entry is read back from its own URL.
  const sync = (): void => {
    const wanted = new URL(location.href).searchParams.get(param);
    const button = wanted
      ? root?.querySelector<HTMLButtonElement>(`button[data-slug="${CSS.escape(wanted)}"]`)
      : null;
    apply(button?.dataset.value ?? "all");
  };

  root?.addEventListener("click", (e) => {
    const button = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-value]");
    if (!button?.dataset.value) return;
    apply(button.dataset.value);
    const url = new URL(location.href);
    if (button.dataset.slug) url.searchParams.set(param, button.dataset.slug);
    else url.searchParams.delete(param);
    if (url.href !== location.href) history.pushState(null, "", url);
  });

  addEventListener("popstate", sync);

  if (new URL(location.href).searchParams.get(param)) sync();
</script>

<style>
  .filter {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  button {
    position: relative;
    font: inherit;
    color: var(--muted);
    background: none;
    border: 1px solid var(--line-interactive);
    padding: 0.4em 1em;
    cursor: pointer;
  }
  @media (pointer: coarse) {
    button {
      min-block-size: 2.75rem;
    }
  }
  button[aria-pressed="true"] {
    color: var(--bg);
    border-color: transparent;
  }
  button[aria-pressed="true"]::before {
    content: "";
    position: absolute;
    inset: -1px;
    z-index: -1;
    background: var(--ink);
  }
</style>
