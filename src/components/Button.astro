---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"a">, "class"> {
  href: string;
  variant?: "primary" | "ghost";
}
const { href, variant = "primary", ...attrs } = Astro.props;
---
<a class:list={["button", variant, variant === "primary" && "cut-fill"]} href={href} {...attrs}><span class="label"><slot /></span></a>

<style>
  .button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    max-width: 100%;
    text-align: center;
    padding: 0.75em 1.25em;
    border: 1px solid transparent;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 120ms, color 120ms;
  }
  .label {
    position: relative;
  }
  .ghost {
    border-color: var(--ink);
  }
  .ghost:hover {
    background: var(--surface);
  }
  .primary {
    color: var(--bg);
  }
  .primary::before {
    content: "";
    position: absolute;
    inset: -1px;
    background: var(--ink);
    transition: background-color 120ms;
  }
  .primary:hover::before {
    background: var(--bright);
  }
  /* Revealed by its own clip rather than base.css's fade: the fill cuts in and the outline draws. */
  :global(:root[data-reveals]) .button[data-reveal]:not([data-reveal="in"]) {
    opacity: 1;
  }
  :global(:root[data-reveals]) .primary[data-reveal]:not([data-reveal="in"])::before,
  :global(:root[data-reveals]) .ghost[data-reveal]:not([data-reveal="in"]) {
    clip-path: inset(0 100% 0 0);
  }
  /* Dark on dark is still faintly there on an antialiased edge; the label waits for its fill. */
  :global(:root[data-reveals]) .primary[data-reveal]:not([data-reveal="in"]) .label {
    opacity: 0;
  }
  .primary[data-reveal="in"] .label {
    animation: fade-in 250ms ease-out 250ms both;
  }
  .button[data-reveal="in"] {
    animation: none;
  }
  .primary[data-reveal="in"]::before {
    animation: cut-in 650ms var(--ease-out) both;
  }
  .ghost[data-reveal="in"] {
    animation: draw 650ms var(--ease-out) both;
  }
</style>
