---
interface Props {
  href: string;
  variant?: "primary" | "ghost";
}
const { href, variant = "primary" } = Astro.props;
---
<a class:list={["button", variant, variant === "primary" && "cut-fill"]} href={href}><span class="label"><slot /></span></a>

<style>
  .button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    max-width: 100%;
    text-align: center;
    padding: 0.75em 1.25em;
    border: 1px solid transparent;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 120ms, color 120ms;
  }
  .label {
    position: relative;
  }
  .ghost {
    border-color: var(--ink);
  }
  .ghost:hover {
    background: var(--surface);
  }
  .primary {
    color: var(--bg);
  }
  .primary::before {
    content: "";
    position: absolute;
    inset: -1px;
    background: var(--ink);
    transition: background-color 120ms;
  }
  .primary:hover::before {
    background: var(--bright);
  }
</style>
