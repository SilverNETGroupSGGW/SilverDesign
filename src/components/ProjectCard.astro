---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";
import { fill, type Locale } from "../lib/i18n";
import type { Project } from "../lib/schemas";

interface Props {
  project: CollectionEntry<"projects">;
  locale: Locale;
  withScreenshot?: boolean;
  headingLevel?: 2 | 3;
  eagerScreenshot?: boolean;
  expanded?: boolean;
}
const {
  project,
  locale,
  withScreenshot = false,
  headingLevel = 3,
  eagerScreenshot = false,
  expanded = false,
} = Astro.props;
const p = project.data;
const copy = (await getEntry("copy", locale))!.data;

// Listed file by file rather than globbed: every match is emitted into the build whether a project
// declares it or not, and the masters in that directory are three times the weight of the crops.
// tests/content.test.ts keeps this list and the declared screenshots in step.
const screenshots = import.meta.glob<{ default: ImageMetadata }>(
  "../../brand/screenshots/{kampus-sggw-map-crop.jpg,plan-wzim-day-crop.png}",
);
const shot =
  withScreenshot && p.screenshot
    ? (await screenshots[`../../brand/screenshots/${p.screenshot}`]?.())?.default
    : undefined;

const platformNames: Record<Project["platforms"][number], string> = {
  android: copy.projects.platformAndroid,
  ios: copy.projects.platformIos,
  web: copy.projects.platformWeb,
  api: copy.projects.platformApi,
};

const links = [
  p.links.play && { href: p.links.play, label: copy.projects.play },
  p.links.appStore && { href: p.links.appStore, label: copy.projects.appStore },
  p.links.github && { href: p.links.github, label: copy.projects.github },
].filter((l): l is { href: string; label: string } => Boolean(l));

// The first screenshot of a listing is the page's LCP element: the default quality puts it at
// 130 KB, which costs the page ~5 Lighthouse performance points. Card screenshots render
// grayscale at 85% opacity, so 65 is invisible here.
const shotQuality = 65;
---
<article class="card cut" data-status={p.status}>
  {shot && (
    <Image
      src={shot}
      alt={fill(copy.projects.shotAlt, { name: p.name })}
      width={420}
      widths={[420, 840]}
      sizes="(min-width: 60rem) 420px, (min-width: 34rem) 50vw, 100vw"
      class="shot"
      quality={shotQuality}
      loading={eagerScreenshot ? "eager" : "lazy"}
      fetchpriority={eagerScreenshot ? "high" : undefined}
    />
  )}
  <div class="body">
    {headingLevel === 2 ? <h2 class="name">{p.name}</h2> : <h3 class="name">{p.name}</h3>}
    <p class="result">{p.result[locale]}</p>
    <p class="summary">{p.summary[locale]}</p>
    {expanded && (
      <p class="platforms">
        <span class="label">{copy.projects.platforms}</span>{" "}
        <span>{p.platforms.map((k) => platformNames[k]).join(" · ")}</span>
      </p>
    )}
    <p class="tech mono">{p.tech.join(" · ")}</p>
    <p class="links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </p>
  </div>
</article>

<style>
  .card {
    display: grid;
    align-content: start;
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .shot {
    width: 100%;
    /* Fixed here as well as in the crops: a screenshot added at another aspect would otherwise
       make the cards in a row start their bodies at different heights. */
    aspect-ratio: 9 / 5;
    max-height: 18rem;
    object-fit: cover;
    object-position: top;
    filter: saturate(0);
    opacity: 0.85;
  }
  .body {
    padding: var(--space-4);
    display: grid;
    gap: var(--space-2);
  }
  .name {
    font-size: var(--step-1);
  }
  .result {
    color: var(--bright);
    font-weight: 500;
  }
  .summary,
  .tech,
  .platforms {
    color: var(--muted);
  }
  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .platforms .label {
    font-weight: 500;
  }
  .links {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .links a {
    padding-block: 0.45rem;
  }
</style>
