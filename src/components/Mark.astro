---
import { markPathId, markPattern, markViewBox } from "../lib/mark";

interface Props {
  size?: string;
}
const { size = "4rem" } = Astro.props;
// Each render gets its own pattern id: two marks on one page would otherwise both
// resolve url(#foil) to the first one's pattern.
const uid = Math.random().toString(36).slice(2, 8);
---
<span class="mark" style={`--size:${size}`} aria-hidden="true">
  <svg viewBox={markViewBox}>
    <defs set:html={markPattern(uid)} />
    <use href={`#${markPathId}`} fill={`url(#foil-${uid})`} />
  </svg>
</span>

<style>
  .mark {
    display: inline-block;
    inline-size: var(--size);
    aspect-ratio: 1;
  }
  .mark :global(svg) {
    inline-size: 100%;
    block-size: 100%;
  }
</style>
