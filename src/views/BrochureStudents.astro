---
import { getCollection, getEntry } from "astro:content";
import Mark from "../components/Mark.astro";
import Qr from "../components/Qr.astro";
import Brochure from "../layouts/Brochure.astro";
import type { Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = (await getEntry("copy", locale))!.data;
const site = (await getEntry("site", "site"))!.data;
const b = copy.brochure.students;
const apps = (await getCollection("projects"))
  .filter((p) => p.data.status === "store")
  .toSorted((a, c) => a.data.order - c.data.order);
---
<Brochure locale={locale} title={`${site.name} — ${b.title}`} markTop="478px">
  <div class="markwrap"><Mark size="var(--mark-size)" ribbon /></div>

  <header class="block masthead" style="--left:96px;--w:1048px">
    <h1>
      <span class="wordmark">{site.name}</span>
      <span class="tagline">{b.title}</span>
    </h1>
    <p class="lead muted">{b.lead}</p>
  </header>

  <h2 class="block over angled" style="--left:96px;--w:228px;--lift:414px">{b.stepsHeading}</h2>
  <ol class="block over stair" style="--left:96px;--w:724px;--anchor:324px;--n:3;--card-h:390px">
    {copy.steps.items.map((s, i) => (
      <li class="card cut" style={`--i:${i}`}>
        <strong>{s.title}</strong>
        <span class="muted">{s.body}</span>
      </li>
    ))}
  </ol>

  <ul class="block under stair" style="--left:520px;--w:548px;--n:2;--card-h:340px">
    {apps.map((p, i) => (
      <li class="card cut" style={`--i:${i}`}>
        <strong>{p.data.name}</strong>
        <span class="muted">{p.data.summary[locale]}</span>
        <span class="mono">{p.data.result[locale]}</span>
      </li>
    ))}
  </ul>
  <h2 class="block under angled" style="--left:96px;--w:400px">{b.appsHeading}</h2>

  <footer class="block foot" style="--left:96px;--w:1048px">
    <div class="ask">
      <p class="threshold">{b.threshold}</p>
      <div class="lines">
        <p class="mono">{site.discord.replace("https://", "")}</p>
        <p class="mono muted">{site.email}</p>
        <p class="mono muted">{copy.join.room} {site.room}, {site.address[0]}</p>
      </div>
    </div>
    <div class="code">
      <Qr value={site.discord} size={203} />
      <p>{b.qrLabel}</p>
    </div>
  </footer>
</Brochure>

<style>
  .threshold {
    font-size: var(--print-step-2);
    font-weight: 500;
    max-width: 30ch;
  }
</style>
