---
import { getCollection, getEntry } from "astro:content";
import Lockup from "../components/Lockup.astro";
import Mark from "../components/Mark.astro";
import Qr from "../components/Qr.astro";
import Brochure from "../layouts/Brochure.astro";
import type { Locale } from "../lib/i18n";
import { isMeasurement } from "../lib/schemas";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = (await getEntry("copy", locale))!.data;
const site = (await getEntry("site", "site"))!.data;
const b = copy.brochure.students;
const apps = (await getCollection("projects"))
  .filter((p) => p.data.status === "store")
  .toSorted((a, c) => a.data.order - c.data.order);
---
<Brochure locale={locale} title={`${site.name} — ${b.title}`} markTop="752px">
  <div class="markwrap"><Mark size="var(--mark-size)" ribbon /></div>

  <header class="block masthead" style="--left:96px;--w:1048px">
    <h1>
      <Lockup size="calc(1.4 * var(--print-step-5))" />
      <span class="visually-hidden">{site.name}</span>
      <span class="tagline">{b.title}</span>
    </h1>
    <p class="lead muted">{b.lead}</p>
  </header>

  <section class="block row" style="--left:96px;--w:1048px;--top:270px">
    <h2 class="angled">{b.stepsHeading}</h2>
    <ol class="cards" style="--cols:3">
      {copy.steps.items.map((s, i) => (
        <li class="card cut">
          <span class="n mono">0{i + 1}</span>
          <strong>{s.title}</strong>
          <span class="muted">{s.body}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="block row over" style="--left:96px;--w:644px;--anchor:740px">
    <h2 class="angled">{b.appsHeading}</h2>
    <ul class="cards" style="--cols:2">
      {apps.map((p) => (
        <li class="card cut">
          <strong>{p.data.name}</strong>
          <span class="muted">{p.data.summary[locale]}</span>
          <span class:list={[isMeasurement(p.data.result[locale]) && "mono"]}>
            {p.data.result[locale]}
          </span>
        </li>
      ))}
    </ul>
  </section>

  <footer class="block plate under cut" style="--left:460px;--w:684px">
    <div class="ask">
      <p class="threshold">{b.threshold}</p>
      <div class="lines">
        <p class="mono">{site.discord.replace("https://", "")}</p>
        <p class="mono muted">{site.email}</p>
        <p class="mono muted">{copy.join.room} {site.room}, {site.address[0]}</p>
      </div>
    </div>
    <div class="code">
      <Qr value={site.discord} size={175} />
      <p>{b.qrLabel}</p>
    </div>
  </footer>
</Brochure>

<style>
  .n {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .threshold {
    font-size: var(--print-step-2);
    font-weight: 500;
    max-width: 30ch;
  }
</style>
