---
import { getCollection, getEntry } from "astro:content";
import Button from "../components/Button.astro";
import Mark from "../components/Mark.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Steps from "../components/Steps.astro";
import Base from "../layouts/Base.astro";
import { pathFor, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = (await getEntry("copy", locale))!.data;
const site = (await getEntry("site", "site"))!.data;
const projects = (await getCollection("projects")).toSorted((a, b) => a.data.order - b.data.order);
const orgTech = [...new Set(projects.flatMap((p) => p.data.tech))];
---
<Base
  locale={locale}
  route="home"
  title={copy.meta.title}
  description={copy.meta.description}
  preloadTexture
>
  <section class="hero">
    <div class="band" aria-hidden="true"></div>
    <div class="container inner">
      <div class="markwrap">
        <Mark size="var(--mark-size)" interactive />
      </div>
      <div class="copy">
        <h1>{copy.hero.title}</h1>
        <p class="lead">{copy.hero.lead}</p>
        <div class="ctas">
          <Button href={site.discord}>{copy.hero.ctaDiscord}</Button>
          <Button href={pathFor("projects", locale)} variant="ghost">{copy.hero.ctaProjects}</Button>
        </div>
      </div>
    </div>
  </section>

  <Steps steps={copy.steps} />

  <section class="projects container" aria-labelledby="projects-heading">
    <h2 class="angled" id="projects-heading">{copy.projects.heading}</h2>
    <p class="lead">{copy.projects.lead}</p>
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} locale={locale} withScreenshot />)}
    </div>
    <p><a href={pathFor("projects", locale)}>{copy.projects.viewAll} →</a></p>
  </section>

  <section class="build container" aria-labelledby="build-heading">
    <h2 class="angled" id="build-heading">{copy.build.heading}</h2>
    <p>{copy.build.what}</p>
    <p>{copy.build.how}</p>
    <p class="muted">{copy.build.inOrg} <span class="mono">{orgTech.join(" · ")}</span></p>
  </section>

  <section id="join" class="join container" aria-labelledby="join-heading">
    <h2 class="angled" id="join-heading">{copy.join.heading}</h2>
    <p class="lead">{copy.join.lead}</p>
    <p>{copy.join.threshold}</p>
    <dl class="facts">
      <dt>{copy.join.discord}</dt><dd><a href={site.discord}>{site.discord.replace("https://", "")}</a></dd>
      <dt>{copy.join.email}</dt><dd><a class="mono" href={`mailto:${site.email}`}>{site.email}</a></dd>
      <dt>{copy.join.room}</dt><dd class="mono">{site.room}, {site.address[0]}</dd>
    </dl>
    <Button href={site.discord}>{copy.hero.ctaDiscord}</Button>
  </section>
</Base>

<style>
  /* The band runs from the container's left edge to the viewport's right one, so its rise is a
     fixed multiple of its own width and the diagonal stays at --angle at every viewport. */
  .hero {
    --band-w: calc(50cqw + min(50cqw - var(--gutter), var(--container) / 2));
    --band-h: calc(var(--band-w) * tan(var(--angle)));
    --mark-size: clamp(6rem, 27cqw, 9rem);
    position: relative;
    isolation: isolate;
    container-type: inline-size;
    display: grid;
    padding-block: 0 var(--space-6);
    overflow: hidden;
  }
  .band {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    inline-size: var(--band-w);
    block-size: var(--band-h);
    z-index: -1;
    background: url("/brand/foil-texture.jpg") center / cover;
    opacity: 0.42;
    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }
  .inner {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr);
  }
  .markwrap {
    display: grid;
    block-size: var(--band-h);
    align-items: end;
    justify-items: end;
    /* Without it the mark's flat foot lands on the band's bottom edge and reads as a clip. */
    padding-block-end: 0.75rem;
  }
  .copy {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr);
  }
  h1 {
    font-size: var(--step-4);
    max-width: 18ch;
    /* At 200% text zoom a single Polish word is wider than a phone viewport. */
    hyphens: auto;
    overflow-wrap: break-word;
  }
  .lead {
    font-size: var(--step-1);
    color: var(--muted);
    max-width: 42rem;
  }
  .ctas {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  @media (min-width: 64rem) {
    .hero {
      --mark-size: clamp(11rem, 20cqw, 17rem);
      padding-block: var(--space-6);
      /* The floor is what the copy needs to clear the diagonal at the narrow end of the split
         layout; from ~80rem up the band's own rise is the taller of the two. */
      min-block-size: max(calc(var(--band-h) + var(--space-7)), 42rem);
    }
    .band {
      inset-block-start: auto;
      inset-block-end: 0;
    }
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
    .copy {
      grid-area: 1 / 1;
      align-self: start;
      /* The copy column overlays the mark's top edge; without this its empty area swallows the
         pointer and the foil snaps back mid-sweep. */
      pointer-events: none;
    }
    .copy h1,
    .copy .lead,
    .copy .ctas a {
      pointer-events: auto;
    }
    .markwrap {
      grid-area: 1 / 1;
      block-size: auto;
      align-self: end;
      padding-block-end: 0;
    }
  }
  /* minmax(0, …) instead of a bare column: a grid track sized to auto never shrinks below the
     longest word, which at 200% text zoom is wider than a phone. */
  .projects,
  .build,
  .join {
    padding-block: var(--space-6);
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr);
  }
  .join {
    justify-items: start;
  }
  h2 {
    font-size: var(--step-3);
  }
  .grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .muted {
    color: var(--muted);
  }
  .facts {
    justify-self: stretch;
    display: grid;
    grid-template-columns: minmax(0, max-content) minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    margin: 0;
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
</style>
