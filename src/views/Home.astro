---
import { getCollection, getEntry } from "astro:content";
import Button from "../components/Button.astro";
import Mark from "../components/Mark.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Steps from "../components/Steps.astro";
import Base from "../layouts/Base.astro";
import { pathFor, type Locale } from "../lib/i18n";
import { markRibbon } from "../lib/mark";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = (await getEntry("copy", locale))!.data;
const site = (await getEntry("site", "site"))!.data;
const projects = (await getCollection("projects")).toSorted((a, b) => a.data.order - b.data.order);
const orgTech = [...new Set(projects.flatMap((p) => p.data.tech))];

// How far below the mark's top edge the ribbon's lower edge sits once it has run back to the mark
// box's own left side, per unit of mark size. The narrow layout's copy starts under that line, so
// the clearance holds at every width without a breakpoint of its own.
const dropPerMark =
  markRibbon.lowerAxis[1]! + markRibbon.halfRise - (1 - markRibbon.lowerAxis[0]!) * markRibbon.slope;
---
<Base
  locale={locale}
  route="home"
  title={copy.meta.title}
  description={copy.meta.description}
  preloadTexture
>
  <section class="hero" style={`--rb-drop:${dropPerMark.toFixed(5)}`}>
    <div class="container inner">
      <div class="markwrap">
        <Mark size="var(--mark-size)" interactive ribbon />
      </div>
      <div class="copy">
        <h1>{copy.hero.title}</h1>
        <p class="lead">{copy.hero.lead}</p>
        <div class="ctas">
          <Button href={site.discord}>{copy.hero.ctaDiscord}</Button>
          <Button href={pathFor("projects", locale)} variant="ghost">{copy.hero.ctaProjects}</Button>
        </div>
      </div>
    </div>
  </section>

  <Steps steps={copy.steps} />

  <section class="projects container" aria-labelledby="projects-heading">
    <h2 class="angled" id="projects-heading">{copy.projects.heading}</h2>
    <p class="lead">{copy.projects.lead}</p>
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} locale={locale} withScreenshot />)}
    </div>
    <p><a href={pathFor("projects", locale)}>{copy.projects.viewAll} →</a></p>
  </section>

  <section class="build container" aria-labelledby="build-heading">
    <h2 class="angled" id="build-heading">{copy.build.heading}</h2>
    <p>{copy.build.what}</p>
    <p>{copy.build.how}</p>
    <p class="muted">{copy.build.inOrg} <span class="mono">{orgTech.join(" · ")}</span></p>
  </section>

  <section id="join" class="join container" aria-labelledby="join-heading">
    <h2 class="angled" id="join-heading">{copy.join.heading}</h2>
    <p class="lead">{copy.join.lead}</p>
    <p>{copy.join.threshold}</p>
    <dl class="facts">
      <dt>{copy.join.discord}</dt><dd><a href={site.discord}>{site.discord.replace("https://", "")}</a></dd>
      <dt>{copy.join.email}</dt><dd><a class="mono" href={`mailto:${site.email}`}>{site.email}</a></dd>
      <dt>{copy.join.room}</dt><dd class="mono">{site.room}, {site.address[0]}</dd>
    </dl>
    <Button href={site.discord}>{copy.hero.ctaDiscord}</Button>
  </section>
</Base>

<style>
  .hero {
    --mark-size: clamp(8rem, 34cqw, 11rem);
    --mark-top: var(--space-4);
    position: relative;
    container-type: inline-size;
    display: grid;
    padding-block-end: var(--space-6);
    /* The ribbon runs off both ends of the mark's svg; the hero is what cuts it to the screen. */
    overflow: hidden;
  }
  .markwrap {
    /* An inline-block on a line box carries the strut's descent; the ribbon's geometry is measured
       from the mark's own box. */
    display: flex;
    position: absolute;
    inset-block-start: var(--mark-top);
    inset-inline-end: var(--gutter);
    inline-size: var(--mark-size);
  }
  .inner {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    /* Clears the ribbon's upper edge where it meets the left gutter: the mark's own offset plus the
       rise over the run from the mark to that edge. */
    padding-block-start: calc(
      var(--mark-top) + (100cqw - 2 * var(--gutter)) * tan(var(--angle)) + var(--mark-size) *
        var(--rb-drop) + var(--space-5)
    );
  }
  .copy {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr);
  }
  h1 {
    font-size: var(--step-4);
    max-width: 18ch;
    /* At 200% text zoom a single Polish word is wider than a phone viewport. */
    hyphens: auto;
    overflow-wrap: break-word;
  }
  .lead {
    font-size: var(--step-1);
    color: var(--muted);
    max-width: 42rem;
  }
  .ctas {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  @media (min-width: 64rem) {
    .hero {
      --mark-size: clamp(20rem, 32cqw, 30rem);
      /* Tall enough that the mark sits low enough for the ribbon to pass a full line's depth under
         the copy on its way to the bottom edge. */
      min-block-size: 48rem;
      padding-block: var(--space-6);
    }
    .inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      align-content: stretch;
      gap: var(--space-5);
      padding-block-start: 0;
    }
    .copy {
      /* The mark comes first in the markup so the copy paints over the ribbon, never under it. */
      grid-area: 1 / 1;
      align-self: start;
      /* The copy column stops well left of the mark, so the diagonal passes under it, not through
         it. */
      max-inline-size: 38rem;
    }
    .markwrap {
      grid-area: 1 / 2;
      position: static;
      inline-size: var(--mark-size);
    }
  }
  /* minmax(0, …) instead of a bare column: a grid track sized to auto never shrinks below the
     longest word, which at 200% text zoom is wider than a phone. */
  .projects,
  .build,
  .join {
    padding-block: var(--space-6);
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr);
  }
  .join {
    justify-items: start;
  }
  h2 {
    font-size: var(--step-3);
  }
  .grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .muted {
    color: var(--muted);
  }
  .facts {
    justify-self: stretch;
    display: grid;
    grid-template-columns: minmax(0, max-content) minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    margin: 0;
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
</style>
