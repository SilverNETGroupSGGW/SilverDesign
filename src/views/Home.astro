---
import { getCollection, getEntry } from "astro:content";
import Button from "../components/Button.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Steps from "../components/Steps.astro";
import Base from "../layouts/Base.astro";
import { pathFor, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = (await getEntry("copy", locale))!.data;
const site = (await getEntry("site", "site"))!.data;
const projects = (await getCollection("projects")).toSorted((a, b) => a.data.order - b.data.order);
const orgTech = [...new Set(projects.flatMap((p) => p.data.tech))];
---
<Base
  locale={locale}
  route="home"
  title={copy.meta.title}
  description={copy.meta.description}
  variant="home"
  heading={copy.hero.title}
  lead={copy.hero.lead}
>
  <Fragment slot="cta">
    <p class="ctas">
      <Button href={site.discord}>{copy.hero.ctaDiscord}</Button>
      <Button href={pathFor("projects", locale)} variant="ghost">{copy.hero.ctaProjects}</Button>
    </p>
  </Fragment>

  <Steps steps={copy.steps} />

  <section class="projects container" aria-labelledby="projects-heading">
    <h2 class="angled" id="projects-heading">{copy.projects.heading}</h2>
    <p class="lead">{copy.projects.lead}</p>
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} locale={locale} withScreenshot />)}
    </div>
    <p><a href={pathFor("projects", locale)}>{copy.projects.viewAll} →</a></p>
  </section>

  <section class="build container" aria-labelledby="build-heading">
    <h2 class="angled" id="build-heading">{copy.build.heading}</h2>
    <p>{copy.build.what}</p>
    <p>{copy.build.how}</p>
    <p class="muted">{copy.build.inOrg} <span class="mono">{orgTech.join(" · ")}</span></p>
  </section>

  <section id="join" class="join container" aria-labelledby="join-heading">
    <h2 class="angled" id="join-heading">{copy.join.heading}</h2>
    <p class="lead">{copy.join.lead}</p>
    <p>{copy.join.threshold}</p>
    <dl class="facts">
      <dt>{copy.join.discord}</dt><dd><a href={site.discord}>{site.discord.replace("https://", "")}</a></dd>
      <dt>{copy.join.email}</dt><dd><a class="mono" href={`mailto:${site.email}`}>{site.email}</a></dd>
      <dt>{copy.join.room}</dt><dd class="mono">{site.room}, {site.address[0]}</dd>
    </dl>
    <Button href={site.discord}>{copy.hero.ctaDiscord}</Button>
  </section>
</Base>

<style>
  /* The buttons stay inline-level: a block-level flex row clears the float's whole box instead of
     following its shape, and the line box they make is what finds a band beside the ribbon wide
     enough to hold the row. Their own block margins are that line box's only leading, so the row
     keeps its gap where it wraps beside the diagonal. */
  .ctas {
    position: relative;
    z-index: 2;
    margin-block-start: 1.2em;
    max-width: none;
    text-align: end;
  }
  .ctas :global(.button) {
    margin-inline-start: 0.6em;
    margin-block: 0.35em;
  }
  /* minmax(0, …) instead of a bare column: a grid track sized to auto never shrinks below the
     longest word, which at 200% text zoom is wider than a phone. */
  .projects,
  .build,
  .join {
    padding-block: var(--space-6);
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr);
  }
  .join {
    justify-items: start;
  }
  h2 {
    font-size: var(--step-3);
  }
  .grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .muted {
    color: var(--muted);
  }
  .facts {
    justify-self: stretch;
    display: grid;
    grid-template-columns: minmax(0, max-content) minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    margin: 0;
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
</style>

<script>
  // The pointer foil is the one motion in the system (spec §8) and the home hero is where it lives,
  // so the module ships with this page instead of with every opener.
  import "../lib/foil";
</script>
