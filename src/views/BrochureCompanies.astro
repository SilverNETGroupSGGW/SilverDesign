---
import { getCollection, getEntry } from "astro:content";
import Opener from "../components/Opener.astro";
import Qr from "../components/Qr.astro";
import Brochure from "../layouts/Brochure.astro";
import type { Locale } from "../lib/i18n";
import { isMeasurement } from "../lib/schemas";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = (await getEntry("copy", locale))!.data;
const site = (await getEntry("site", "site"))!.data;
const b = copy.brochure.companies;
const projects = (await getCollection("projects")).toSorted((a, c) => a.data.order - c.data.order);
---
<Brochure locale={locale} title={`${site.name} — ${b.title}`}>
  <Opener locale={locale} variant="sheet" title={b.title} lead={b.lead} />

  <section class="pair">
    <div class="row">
      <h2 class="angled">{b.whoHeading}</h2>
      <p>{b.who}</p>
    </div>
    <div class="row">
      <h2 class="angled">{b.togetherHeading}</h2>
      <ol class="offers">
        {b.together.map((t) => <li>{t}</li>)}
      </ol>
    </div>
  </section>

  <section class="row">
    <h2 class="angled">{b.builtHeading}</h2>
    <ul class="cards" style="--cols:4">
      {projects.map((p) => (
        <li class="card cut">
          <strong>{p.data.name}</strong>
          <span class:list={[isMeasurement(p.data.result[locale]) && "mono"]}>
            {p.data.result[locale]}
          </span>
          {p.data.status === "store" && <span class="muted">{p.data.tech.join(" · ")}</span>}
        </li>
      ))}
    </ul>
  </section>

  <footer class="plate cut">
    <div class="ask">
      <div>
        <h2 class="quiet">{b.contactHeading}</h2>
        <p class="chair">{site.chair}</p>
      </div>
      <div class="lines">
        <p class="mono">{site.email}</p>
        <p class="mono muted">{site.faculty[locale]}, {site.university}</p>
        {site.address.map((line) => <p class="mono muted">{line}</p>)}
      </div>
    </div>
    <div class="code">
      <Qr value={`mailto:${site.email}`} size={175} />
      <p>{b.qrLabel}</p>
    </div>
  </footer>
</Brochure>

<style>
  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--print-space-4);
    align-items: start;
  }
  .offers {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--print-space-2);
  }
  .offers li {
    font-size: var(--print-step--1);
    color: var(--muted);
  }
  .quiet {
    font-size: var(--print-step-1);
  }
  .chair {
    font-size: var(--print-step-2);
    font-weight: 500;
    margin-top: var(--print-space-1);
  }
</style>
