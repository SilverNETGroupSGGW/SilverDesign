---
import { getCollection, getEntry } from "astro:content";
import ProjectCard from "../components/ProjectCard.astro";
import JoinStrip from "../components/JoinStrip.astro";
import ProjectFilter from "../components/ProjectFilter.astro";
import Base from "../layouts/Base.astro";
import type { Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = (await getEntry("copy", locale))!.data;
const site = (await getEntry("site", "site"))!.data;
const projects = (await getCollection("projects")).toSorted((a, b) => a.data.order - b.data.order);
---
<Base
  locale={locale}
  route="projects"
  title={`${copy.projects.heading} — ${site.name}`}
  description={copy.projects.lead}
  variant="page"
  heading={copy.projects.heading}
  lead={copy.projects.lead}
>
  <section class="container page">
    <ProjectFilter copy={copy.projects} locale={locale} />
    <div class="grid">
      {projects.map((p, i) => (
        <ProjectCard
          project={p}
          locale={locale}
          withScreenshot
          headingLevel={2}
          eagerScreenshot={i === 0}
          expanded
        />
      ))}
    </div>
  </section>
  <JoinStrip locale={locale} text={copy.join.stripProjects} />
</Base>

<style>
  .page {
    padding-block: var(--space-6);
    display: grid;
    gap: var(--space-4);
  }
  .grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
